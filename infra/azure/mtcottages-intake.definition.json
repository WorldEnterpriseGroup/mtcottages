{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "d365Organization": {
      "type": "String",
      "defaultValue": "dream.crm"
    },
    "d365BusinessUnitName": {
      "type": "String",
      "defaultValue": "MtCottages"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "properties": {
            "firstName": {"type": "string"},
            "lastName": {"type": "string"},
            "email": {"type": "string"},
            "phone": {"type": "string"},
            "stayType": {"type": "string"},
            "preferredLocation": {"type": "string"},
            "moveInDate": {"type": "string"},
            "duration": {"type": "string"},
            "occupants": {"type": "string"},
            "homeSize": {"type": "string"},
            "pets": {"type": "string"},
            "employment": {"type": "string"},
            "monthlyBudget": {"type": "string"},
            "furnishedNeeds": {"type": "string"},
            "message": {"type": "string"},
            "screeningConsent": {"type": "string"},
            "termsAccepted": {"type": "string"},
            "website": {"type": "string"},
            "sourceUrl": {"type": "string"},
            "propertyId": {"type": "string"}
          },
          "required": ["firstName", "lastName", "email", "phone", "stayType", "preferredLocation", "moveInDate", "duration", "occupants", "message", "termsAccepted"]
        }
      }
    }
  },
  "actions": {
    "Reject_Bot_Submission": {
      "type": "If",
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@coalesce(triggerBody()?['website'], '')",
                ""
              ]
            }
          }
        ]
      },
      "actions": {
        "Respond_Bot": {
          "type": "Response",
          "kind": "Http",
          "inputs": {
            "statusCode": 400,
            "headers": {
              "Access-Control-Allow-Origin": "https://stay.mtcottages.com",
              "Content-Type": "application/json"
            },
            "body": {
              "success": false,
              "message": "Invalid submission"
            }
          }
        },
        "Stop_Bot": {
          "type": "Terminate",
          "runAfter": {
            "Respond_Bot": ["Succeeded"]
          },
          "inputs": {
            "runStatus": "Succeeded"
          }
        }
      },
      "runAfter": {}
    },
    "Find_MtCottages_Business_Unit": {
      "type": "ApiConnection",
      "runAfter": {
        "Reject_Bot_Submission": ["Succeeded"]
      },
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['dynamicscrmonline']['connectionId']"
          }
        },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('d365Organization')))}/tables/@{encodeURIComponent(encodeURIComponent('businessunits'))}/items",
        "queries": {
          "$filter": "@{concat('name eq ''', parameters('d365BusinessUnitName'), '''')}",
          "$top": "1"
        }
      }
    },
    "Require_MtCottages_Business_Unit": {
      "type": "If",
      "runAfter": {
        "Find_MtCottages_Business_Unit": ["Succeeded"]
      },
      "expression": {
        "greater": [
          "@length(body('Find_MtCottages_Business_Unit')?['value'])",
          0
        ]
      },
      "actions": {
        "Find_MtCottages_Owner_Team": {
          "type": "ApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['dynamicscrmonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('d365Organization')))}/tables/@{encodeURIComponent(encodeURIComponent('teams'))}/items",
            "queries": {
              "$filter": "@{concat('_businessunitid_value eq ', first(body('Find_MtCottages_Business_Unit')?['value'])?['businessunitid'], ' and isdefault eq true')}",
              "$top": "1"
            }
          }
        },
        "Require_MtCottages_Owner_Team": {
          "type": "If",
          "runAfter": {
            "Find_MtCottages_Owner_Team": ["Succeeded"]
          },
          "expression": {
            "greater": [
              "@length(body('Find_MtCottages_Owner_Team')?['value'])",
              0
            ]
          },
          "actions": {
            "Create_D365_Applicant_Lead": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['dynamicscrmonline']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('d365Organization')))}/tables/@{encodeURIComponent(encodeURIComponent('leads'))}/items",
                "body": {
                  "_leadqualitycode_label": "Warm",
                  "_leadsourcecode_label": "Web",
                  "_statuscode_label": "New",
                  "address1_city": "@triggerBody()?['preferredLocation']",
                  "address1_country": "United States",
                  "address1_stateorprovince": "@{if(contains(triggerBody()?['preferredLocation'], 'WV'), 'WV', 'OH')}",
                  "companyname": "Mt Cottages",
                  "description": "@{substring(string(triggerBody()), 0, min(length(string(triggerBody())), 99000))}",
                  "donotemail": false,
                  "donotphone": false,
                  "emailaddress1": "@triggerBody()?['email']",
                  "firstname": "@triggerBody()?['firstName']",
                  "jobtitle": "@triggerBody()?['employment']",
                  "lastname": "@triggerBody()?['lastName']",
                  "mobilephone": "@triggerBody()?['phone']",
                  "msdyn_gdproptout": false,
                  "new_goals": "@triggerBody()?['message']",
                  "ownerid@odata.bind": "@{concat('/teams(', first(body('Find_MtCottages_Owner_Team')?['value'])?['teamid'], ')')}",
                  "subject": "@{concat('Mt Cottages — ', triggerBody()?['stayType'], ' — ', triggerBody()?['preferredLocation'], ' — ', triggerBody()?['firstName'], ' ', triggerBody()?['lastName'])}",
                  "telephone1": "@triggerBody()?['phone']"
                }
              }
            },
            "Respond_Success": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Create_D365_Applicant_Lead": ["Succeeded"]
              },
              "inputs": {
                "statusCode": 201,
                "headers": {
                  "Access-Control-Allow-Origin": "https://stay.mtcottages.com",
                  "Content-Type": "application/json"
                },
                "body": {
                  "success": true,
                  "message": "Mt Cottages application accepted"
                }
              }
            },
            "Respond_Failure": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Create_D365_Applicant_Lead": ["Failed", "TimedOut"]
              },
              "inputs": {
                "statusCode": 500,
                "headers": {
                  "Access-Control-Allow-Origin": "https://stay.mtcottages.com",
                  "Content-Type": "application/json"
                },
                "body": {
                  "success": false,
                  "message": "Application intake failed"
                }
              }
            }
          },
          "else": {
            "actions": {
              "Respond_Missing_MtCottages_Owner_Team": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": 503,
                  "headers": {
                    "Access-Control-Allow-Origin": "https://stay.mtcottages.com",
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "success": false,
                    "message": "Mt Cottages intake is not configured"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "actions": {
          "Respond_Missing_MtCottages_Business_Unit": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 503,
              "headers": {
                "Access-Control-Allow-Origin": "https://stay.mtcottages.com",
                "Content-Type": "application/json"
              },
              "body": {
                "success": false,
                "message": "Mt Cottages intake is not configured"
              }
            }
          }
        }
      }
    }
  }
}
