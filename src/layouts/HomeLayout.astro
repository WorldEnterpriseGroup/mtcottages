---
import "../styles/homes.css";
import SiteLayout from "./SiteLayout.astro";
import ResponsivePhoto from "../components/ResponsivePhoto.astro";
import HomeNav from "../components/home/HomeNav.astro";
import FamilySwitcher from "../components/home/FamilySwitcher.astro";
import InquiryPanel from "../components/home/InquiryPanel.astro";
import CheckDates from "../components/CheckDates.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { homeCrumbs, type HomeShell } from "../components/home/shell";
import { guidesForHome, type RelatedLink } from "../data/site";
import { hospitalLandingsForHome, hub, hubHref } from "../data/travelNurses";
import { plantLandingsForHome } from "../data/plantLandings";
import { articlesForHome, guideHref } from "../data/guides";
import type { ImageMetadata } from "astro";
import type { SchemaNode } from "../data/schema";

interface Props {
  shell: HomeShell;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
  hero: { src: ImageMetadata; alt: string; caption?: string; focal?: string };
  heroCaption?: string;
  /** Address chip shown under the lede, e.g. "125 Frederick St, Marietta, OH 45750". */
  chip?: string;
  schema?: SchemaNode | SchemaNode[];
  /** Use the hero photo as the link-preview image (otherwise the site default). */
  shareHero?: boolean;
  inquiryExtra?: { label: string; href: string };
}

const { shell, title, description, eyebrow, heading, lede, hero, heroCaption, chip, schema, shareHero = false, inquiryExtra } = Astro.props as Props;
// Home / Locations / Marietta, Ohio / Frederick Cottage [/ Tour]: shown in the hero and published as the BreadcrumbList (#35).
const crumbs = homeCrumbs(shell, Astro.url.pathname);
// The home's cluster: its town page and the living guides that feature it.
const related: RelatedLink[] = [
  { href: shell.townHref, label: `Furnished homes in ${shell.townLabel}`, note: `Every listed home in ${shell.townName}, with measured drive times and what living there is like.` },
  // The travel-nurse hub features every listed home, so every home links back to it.
  { href: hubHref, label: hub.h1, note: hub.description },
  // The hospital landings (#32, #33, #45) that recommend this home.
  ...hospitalLandingsForHome(shell.id),
  // The plant crew landings (#44, #43) that list this home.
  ...plantLandingsForHome(shell.id),
  ...guidesForHome(shell.id).map((guide) => ({ href: `/${guide.path}`, label: guide.title, note: guide.description })),
  // Area guides (#47) about this home.
  ...articlesForHome(shell.id).map((article) => ({ href: guideHref(article), label: article.h1, note: article.description })),
];
---

<SiteLayout title={title} description={description} schema={schema} socialImage={shareHero ? hero.src : undefined} socialImageAlt={shareHero ? hero.alt : undefined} home={shell.id} breadcrumbs={crumbs}>
  <HomeNav shell={shell} current={Astro.url.pathname} />

  <section class="residence-hero hm-hero section--tight">
    <div class="site-width residence-hero-grid">
      <div>
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow mt-3">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="lede">{lede}</p>
        {chip && <p class="hm-chip"><span aria-hidden="true">⌖</span> <span class="sr-only">Address: </span>{chip}</p>}
        <CheckDates class="mt-3" placement="hero" home={shell.id} secondary={Astro.url.pathname.endsWith("/location.html") ? undefined : { label: "See distances", href: shell.distancesHref }} />
      </div>
      <figure class="hero-image-frame residence-hero-media hm-hero-media">
        <ResponsivePhoto src={hero.src} alt={hero.alt} focal={hero.focal} caption={hero.caption} priority sizes="(max-width: 900px) 100vw, 58vw" />
        <figcaption>{heroCaption || hero.caption || hero.alt}</figcaption>
      </figure>
    </div>
  </section>

  <div class="residence-body">
    <slot />
  </div>

  <RelatedLinks links={related} eyebrow={`Around ${shell.name}`} heading="The town and the guides for this home." />
  <FamilySwitcher currentId={shell.id} />
  <InquiryPanel shell={shell} extra={inquiryExtra} />

  <script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "IntersectionObserver" in window) {
      const items = document.querySelectorAll(".reveal");
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      items.forEach((item) => observer.observe(item));
    } else {
      document.querySelectorAll(".reveal").forEach((item) => item.classList.add("is-visible"));
    }
  </script>
</SiteLayout>
