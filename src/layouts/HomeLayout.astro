---
import "../styles/homes.css";
import SiteLayout from "./SiteLayout.astro";
import ResponsivePhoto from "../components/ResponsivePhoto.astro";
import HomeNav from "../components/home/HomeNav.astro";
import FamilySwitcher from "../components/home/FamilySwitcher.astro";
import InquiryPanel from "../components/home/InquiryPanel.astro";
import type { HomeShell } from "../components/home/shell";
import type { ImageMetadata } from "astro";

interface Props {
  shell: HomeShell;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
  hero: { src: ImageMetadata; alt: string; caption?: string; focal?: string };
  heroCaption?: string;
  /** Address chip shown under the lede, e.g. "125 Frederick St, Marietta, OH 45750". */
  chip?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Use the hero photo as the link-preview image (otherwise the site default). */
  shareHero?: boolean;
  inquiryExtra?: { label: string; href: string };
}

const { shell, title, description, eyebrow, heading, lede, hero, heroCaption, chip, schema, shareHero = false, inquiryExtra } = Astro.props as Props;
---

<SiteLayout title={title} description={description} schema={schema} socialImage={shareHero ? hero.src : undefined} socialImageAlt={shareHero ? hero.alt : undefined}>
  <HomeNav shell={shell} current={Astro.url.pathname} />

  <section class="residence-hero hm-hero section--tight">
    <div class="site-width residence-hero-grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href={shell.townHref}>{shell.townName}</a><span aria-hidden="true">/</span>
          <a href={shell.baseHref}>{shell.name}</a>
        </nav>
        <p class="eyebrow mt-3">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="lede">{lede}</p>
        {chip && <p class="hm-chip"><span aria-hidden="true">⌖</span> <span class="sr-only">Address: </span>{chip}</p>}
        <div class="cluster mt-3">
          <a class="button" href={shell.inquiryUrl}>Ask about this home <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="hero-image-frame residence-hero-media hm-hero-media">
        <ResponsivePhoto src={hero.src} alt={hero.alt} focal={hero.focal} caption={hero.caption} priority sizes="(max-width: 900px) 100vw, 58vw" />
        <figcaption>{heroCaption || hero.caption || hero.alt}</figcaption>
      </figure>
    </div>
  </section>

  <div class="residence-body">
    <slot />
  </div>

  <FamilySwitcher currentId={shell.id} />
  <InquiryPanel shell={shell} extra={inquiryExtra} />

  <script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "IntersectionObserver" in window) {
      const items = document.querySelectorAll(".reveal");
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      items.forEach((item) => observer.observe(item));
    } else {
      document.querySelectorAll(".reveal").forEach((item) => item.classList.add("is-visible"));
    }
  </script>
</SiteLayout>
