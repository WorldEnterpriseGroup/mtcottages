---
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteLightbox from "../components/SiteLightbox.astro";
import { stayApplicationUrl } from "../data/site";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import favicon from "../../assets/images/fav-icon/icon.png";
import socialImage from "../../assets/images/cottages/marietta-01/frederick-exterior-full-safe.avif";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
}
const { title, description, canonical, noindex = false, schema, socialImage: pageSocialImage, socialImageAlt } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, "https://mtcottages.com").toString();
const socialAsset = pageSocialImage ?? socialImage;
// Link-preview crawlers (Facebook, LinkedIn, iMessage, Slack) do not read AVIF,
// so shared links get a JPEG rendition of the page image.
const socialJpeg = await getImage({ src: socialAsset, format: "jpg", width: Math.min(1200, socialAsset.width), quality: 82 });
const socialUrl = new URL(socialJpeg.src, "https://mtcottages.com").toString();
// Chromium prerenders a same-site page as soon as a visitor signals intent
// (hover or touch start), so the click lands on an already-rendered page.
const speculationRules = {
  prerender: [{
    where: { and: [{ href_matches: "/*" }, { not: { selector_matches: "[target=_blank], [download], [rel~=nofollow]" } }] },
    eagerness: "moderate",
  }],
};
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: "Mt Cottages",
  url: "https://mtcottages.com/",
  email: "stay@mtcottages.com",
  image: socialUrl,
  areaServed: ["Marietta, Ohio", "Parkersburg, West Virginia", "Ravenswood, West Virginia", "Racine, Ohio"],
};
const schemas = [organizationSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={favicon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mt Cottages" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:alt" content={socialImageAlt || "A furnished Mt Cottages home in the Mid-Ohio Valley"} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(socialJpeg.attributes.width)} />
    <meta property="og:image:height" content={String(socialJpeg.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#3f4d3c" />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <script type="speculationrules" set:html={JSON.stringify(speculationRules)} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <aside class="mobile-action" aria-label="Stay inquiry shortcut"><span><strong>Planning a furnished stay?</strong><small>Tell us the timing and household.</small></span><a href={stayApplicationUrl}>Start inquiry</a></aside>
    <SiteFooter />
    <SiteLightbox />
  </body>
</html>
