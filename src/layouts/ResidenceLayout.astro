---
import { stayApplicationUrl } from "../data/site";
import HomeLayout from "./HomeLayout.astro";
import { residenceShell } from "../components/home/shell";
import type { Residence, ResidencePhoto } from "../data/residences";

interface Props {
  residence: Residence;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
  hero?: ResidencePhoto;
  heroCaption?: string;
  heroAlt?: boolean;
}

const { residence, title, description, eyebrow, heading, lede, hero, heroCaption } = Astro.props as Props;
const heroPhoto = hero ?? residence.hero;
const [locality, region] = residence.town.split(",").map((part) => part.trim());
const monthly = Number(residence.price.replace(/[^0-9.]/g, ""));
const bedrooms = Number.parseInt(residence.bedrooms, 10);
const sleeps = Number.parseInt(residence.facts.find((fact) => fact.label === "Sleeps")?.value ?? "", 10);
const chip = residence.address ? `${residence.address.streetAddress}, ${locality}, ${region} ${residence.address.postalCode}` : undefined;
const homeUrl = new URL(`/${residence.basePath}/index.html`, "https://mtcottages.com").toString();
const home = {
  "@context": "https://schema.org",
  "@type": "Accommodation",
  "@id": `${homeUrl}#home`,
  name: residence.name,
  description: residence.summary,
  url: homeUrl,
  ...(Number.isFinite(bedrooms) && { numberOfBedrooms: bedrooms }),
  ...(Number.isFinite(sleeps) && { occupancy: { "@type": "QuantitativeValue", maxValue: sleeps } }),
  address: {
    "@type": "PostalAddress",
    ...(residence.address && { streetAddress: residence.address.streetAddress, postalCode: residence.address.postalCode }),
    addressLocality: locality,
    addressRegion: region,
    addressCountry: "US",
  },
  containedInPlace: { "@type": "Place", name: "Mid-Ohio Valley" },
};
// schema.org has no price on Accommodation itself, so the monthly rate is a
// separate Offer for the home.
const schema = monthly > 0
  ? [home, {
      "@context": "https://schema.org",
      "@type": "Offer",
      itemOffered: { "@id": home["@id"] },
      url: `${stayApplicationUrl}?property=${encodeURIComponent(residence.id)}`,
      priceSpecification: { "@type": "UnitPriceSpecification", price: monthly, priceCurrency: "USD", unitCode: "MON" },
    }]
  : home;
---

<HomeLayout
  shell={residenceShell(residence)}
  title={title}
  description={description}
  eyebrow={eyebrow}
  heading={heading}
  lede={lede}
  hero={heroPhoto}
  heroCaption={heroCaption}
  chip={chip}
  schema={schema}
  inquiryExtra={{ label: "Read the handbook", href: `/${residence.basePath}/handbook.html` }}
>
  <slot />
</HomeLayout>
