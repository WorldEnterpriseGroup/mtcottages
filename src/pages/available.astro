---
import BaseLayout from "../layouts/BaseLayout.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { properties } from "../data/properties";
---

<BaseLayout title="Available furnished cottages" description="See currently available furnished monthly homes from M&T Cottages.">
  <section class="town-intro shell"><p class="eyebrow">Available now</p><h1>Good homes, ready when you are.</h1><p class="lede">Our cottages are furnished, maintained, and ready for the next person who needs a place to land.</p></section>
  <section class="section section-tone"><div class="shell"><div class="property-grid">{properties.map((property) => <PropertyCard property={property} />)}</div></div></section>
</BaseLayout>
