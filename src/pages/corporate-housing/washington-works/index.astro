---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import WashingtonWorksPage from "../../../components/WashingtonWorksPage.astro";
import { faqSchema, type Crumb } from "../../../data/schema";
import { homes } from "../../../data/homes";
import { faqs, hubAudience, hubHref, nearest, page, washingtonWorksHref } from "../../../data/washingtonWorks";

// Washington Works crew landing (#44), under the corporate and crew hub (#34).
const crumbs: Crumb[] = [
  { name: "Home", href: "/" },
  { name: "Corporate and crew housing", href: hubHref },
  { name: "Washington Works", href: washingtonWorksHref },
];
// The real hero photo of the home nearest the plant, never a plant image.
const home = homes.find((entry) => entry.id === nearest.homeId);
if (!home) throw new Error(`Washington Works page: nearest home "${nearest.homeId}" has no live microsite`);
const hero = { src: home.hero.src, alt: home.hero.alt, focal: home.hero.focal ?? "center" };
---
<SiteLayout
  title={page.title}
  description={page.description}
  audience={hubAudience}
  breadcrumbs={crumbs}
  socialImage={hero.src}
  socialImageAlt={hero.alt}
  schema={faqSchema(washingtonWorksHref, faqs)}
>
  <WashingtonWorksPage crumbs={crumbs} hero={hero} />
</SiteLayout>
