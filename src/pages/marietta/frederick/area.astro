---
import ResidenceLayout from "../../../layouts/ResidenceLayout.astro";
import { frederick } from "../../../data/residences/frederick";
---

<ResidenceLayout
  residence={frederick}
  title="Nearby guide · Frederick Cottage | Mt Cottages"
  description="Simple nearby guide for Frederick Cottage in Marietta, OH: trails, restaurants, shopping, hospitals, parks, events, transit, and essentials — with map links."
  eyebrow="Frederick Cottage · Nearby"
  heading="What's around the cottage."
  lede="Short lists, verified names, map links. Cottage address stays private — tap a map link to check drive time."
>
  <section class="section section--paper">
    <div class="site-width">
      <nav class="guide-tabs reveal" aria-label="Nearby guide sections">
        <a href="#trails">Trails</a>
        <a href="#restaurants">Food</a>
        <a href="#shopping">Shopping</a>
        <a href="#hospitals">Hospitals</a>
        <a href="#parks">Parks</a>
        <a href="#events">Events</a>
        <a href="#transit">Transit</a>
        <a href="#amenities">Essentials</a>
      </nav>
    </div>
  </section>

  <section class="section" id="trails">
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Trails</h2></div></div>
      <p class="section-sub reveal">Where to walk.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Marietta River Trail</strong><p>Paved riverfront path, ~4 miles. Downtown to Indian Acres. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Marietta+River+Trail+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Kiwanis Loop</strong><p>Easy 0.8-mile paved loop at Indian Acres Park. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kiwanis+Trail+Indian+Acres+Park+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Marietta Trail Network</strong><p>15+ miles of woods trails for hiking/biking. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Marietta+Trail+Network+Marietta+High+School+Marietta+OH" rel="noopener">Map ↗</a></p></li>
      </ol>
      <div class="faq mt-3 reveal"><details><summary>More trails (Broughton, Wayne Forest)</summary><p><strong>Broughton's Nature Area</strong> — quiet woods trails off SR 821. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Broughton+Nature+Wildlife+Area+Marietta+OH" rel="noopener">Map ↗</a><br /><strong>Wayne National Forest – Marietta Unit</strong> — day trip. Archer's Fork 14-mi loop, Covered Bridge Trail, Kinderhook 12-mi. <a class="text-link" href="https://rvmba.com/" rel="noopener">Trail group ↗</a></p></details></div>
    </div>
  </section>

  <section class="section section--paper" id="restaurants">
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Food</h2></div></div>
      <p class="section-sub reveal">Where to eat. Confirm hours before going.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>The Gunroom</strong><p>American, river view, in Lafayette Hotel. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Gunroom+Restaurant+101+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Austyn's</strong><p>Local favorite near the rivers. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Austyn%27s+Restaurant+130+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Levee House Bistro</strong><p>Steaks, seafood, patio on the river. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Levee+House+Bistro+127+Ohio+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Boathouse BBQ</strong><p>BBQ + outdoor tables by the water. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Boathouse+BBQ+218+Virginia+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Over the Moon Pizza</strong><p>Casual pizza pub downtown. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Over+the+Moon+Pub+Pizza+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Tampico + The Galley</strong><p>Mexican (221 2nd St) and American (203 2nd St). <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Tampico+Mexican+Restaurant+Marietta+OH" rel="noopener">Map ↗</a></p></li>
      </ol>
      <div class="faq mt-3 reveal"><details><summary>More: coffee, breakfast, tavern</summary><p><strong>Jeremiah's Coffee House</strong> — downtown coffee. <strong>Busy Bee</strong> — breakfast since 1944. <strong>Harmar Tavern</strong> — oldest tavern, across the bridge. <strong>Spagna's</strong> — Italian dinners. <a class="text-link" href="https://www.mariettamainstreet.org/dining" rel="noopener">Full dining list ↗</a></p></details></div>
    </div>
  </section>

  <section class="section" id="shopping">
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Shopping</h2></div></div>
      <p class="section-sub reveal">Where to shop. Daily needs on Pike St off I-77.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Lafayette Plaza</strong><p>Pike St. Ollie's, Harbor Freight, Planet Fitness. Across from Kroger. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Lafayette+Plaza+Pike+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Walmart + Kroger</strong><p>804 Pike St and 40 Acme St. Groceries + pharmacy. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Walmart+Kroger+Pike+Street+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Grand Central Mall</strong><p>Vienna, WV. Only big enclosed mall nearby, 90+ stores. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Grand+Central+Mall+Vienna+WV" rel="noopener">Map ↗</a></p></li>
      </ol>
    </div>
  </section>

  <section class="section section--paper" id="hospitals">
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Hospitals</h2></div></div>
      <p class="section-sub reveal">If you need care. Emergency? Call 911.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Marietta Memorial Hospital</strong><p>401 Matthew St · (740) 374-1400. Main hospital + ER. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Marietta+Memorial+Hospital+401+Matthew+Street+Marietta+OH" rel="noopener">Directions ↗</a></p></li>
        <li class="reveal"><strong>Selby General Hospital</strong><p>1106 Colegate Dr · (740) 568-2000. Hospital + ER. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Selby+General+Hospital+1106+Colegate+Drive+Marietta+OH" rel="noopener">Directions ↗</a></p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="parks">
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Parks</h2></div></div>
      <p class="section-sub reveal">Green time. Photos live on official City/CVB pages.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Muskingum Park</strong><p>Riverfront + monument. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Muskingum+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>East Muskingum Park</strong><p>Pavilion + gazebo, river views. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=East+Muskingum+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>Buckeye Park</strong><p>Playground, pond, sports fields. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Buckeye+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>Gold Star Park</strong><p>Disc golf, tennis/pickleball. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Gold+Star+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>Indian Acres Park</strong><p>Boat ramp, skate park, pool. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Indian+Acres+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>Ohio River Levee</strong><p>Levee walks + festival grounds. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Ohio+River+Levee+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
      </ol>
    </div>
  </section>

  <section class="section section--paper" id="events">
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Events</h2></div></div>
      <p class="section-sub reveal">Worth timing. Confirm dates yearly — downtown fills fast.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Sternwheel Festival</strong><p>Riverfront · Sept 11–13, 2026. Boats, music, fireworks. Free. <a class="text-link" href="https://sternwheel.org/" rel="noopener">Details ↗</a></p></li>
        <li class="reveal"><strong>First Friday</strong><p>Downtown · first Friday monthly, 5–9pm. Shops + music. <a class="text-link" href="https://www.mariettamainstreet.org/first-fridays" rel="noopener">Details ↗</a></p></li>
        <li class="reveal"><strong>Group bike rides</strong><p>Last Monday monthly, Apr–Oct, 5:30pm. 2nd & Butler St. Hosted by RVMBA. <a class="text-link" href="https://rvmba.com/" rel="noopener">Ride details ↗</a></p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="transit">
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Transit</h2></div></div>
      <p class="section-sub reveal">Getting around. No fixed bus routes — CABL picks you up at your curb. Most guests use a car.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>CABL On-Demand</strong><p>Mon–Fri 7–5, Sat morning–1. $1/ride. Book: app or (740) 373-7671. <a class="text-link" href="http://www.wmcap.org/transportation" rel="noopener">How to book ↗</a></p></li>
        <li class="reveal"><strong>CABL Dial-A-Ride</strong><p>For trips outside Marietta, anywhere in the county. $2/ride. Same number. <a class="text-link" href="http://www.wmcap.org/transportation" rel="noopener">Details ↗</a></p></li>
      </ol>
    </div>
  </section>

  <section class="section section--paper" id="amenities">
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Essentials</h2></div></div>
      <p class="section-sub reveal">Groceries, pharmacy, library.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Groceries</strong><p>Kroger, Walmart, ALDI on Pike/Acme. Huck's Farm Market for local produce. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kroger+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Pharmacy</strong><p>Kroger Pharmacy + Walmart Pharmacy on site. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=pharmacy+Pike+Street+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Library</strong><p>615 Fifth St. Free wi-fi, computers. Mon–Thu 9–7, Fri 9–6, Sat 10–2. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Washington+County+Public+Library+Marietta+OH" rel="noopener">Map ↗</a></p></li>
      </ol>
    </div>
  </section>
</ResidenceLayout>

<style>
  .guide-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
  }
  .guide-tabs a {
    display: block;
    padding: 1rem 0.5rem;
    color: var(--forest);
    font-size: 1.15rem;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0.8rem;
  }
  .guide-tabs a:hover {
    border-color: var(--accent);
  }
  section[id] .section-heading h2 {
    font-size: clamp(2.1rem, 1.6rem + 2.4vw, 3.4rem);
  }
  section[id] > .site-width > .section-sub {
    color: var(--forest);
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.25;
  }
  ol.step-grid strong {
    font-size: 1.45rem;
    font-weight: 800;
  }
  ol.step-grid p {
    font-size: 1.05rem;
  }
  @media (max-width: 560px) {
    .guide-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
