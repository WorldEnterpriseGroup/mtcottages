---
import ResidenceLayout from "../../../layouts/ResidenceLayout.astro";
import ResponsivePhoto from "../../../components/ResponsivePhoto.astro";
import Accordion from "../../../components/Accordion.astro";
import Slideout from "../../../components/Slideout.astro";
import HeroCarousel from "../../../components/HeroCarousel.astro";
import SplitFeature from "../../../components/SplitFeature.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DrillRail from "../../../components/DrillRail.astro";
import ScrollDepth from "../../../components/ScrollDepth.astro";
import { frederick, frederickPhotos } from "../../../data/residences/frederick";

/* ── Hero carousel ── */
const heroSlides = [
  {
    photo: frederickPhotos.buckeyeFields,
    eyebrow: "Parks · Buckeye Park — next door",
    title: "Sports fields and a pond, right beside the cottage.",
    lede: "Walk to softball fields, a fishing pond, playground, basketball court, and a picnic shelter.",
    ctaHref: "#parks",
    ctaLabel: "See parks",
  },
  {
    photo: frederickPhotos.nearbyTrail,
    eyebrow: "Trails · Kroger Wetlands & beyond",
    title: "14.5 acres of wetlands, behind the Kroger.",
    lede: "Birding, wildflowers, and a 0.4-mile easy loop — plus river trails, Kiwanis, and Wayne National Forest day trips.",
    ctaHref: "#trails",
    ctaLabel: "See trails",
  },
  {
    photo: frederickPhotos.nearbyFood,
    eyebrow: "Food · Downtown Marietta",
    title: "River views, local kitchens, and a bistro on the levee.",
    lede: "The Gunroom, Levee House Bistro, Austyn's, Boathouse BBQ — all within a short drive.",
    ctaHref: "#restaurants",
    ctaLabel: "See dining",
  },
];

/* ── Accordions ── */
const trailFaqs = [
  { title: "More trails: Broughton's Nature Area", body: "Quiet woods trails off SR 821 — a good option when you want solitude over amenities. Confirm conditions before going. Search 'Broughton Nature Wildlife Area Marietta OH' in your maps app." },
  { title: "Can I bike the river trail?", body: "Yes. The Marietta River Trail (~3.3 miles) is paved and flat — fine for cycling. The Marietta Trail Network near the high school adds 15+ miles of woods trails for more serious rides." },
];
const foodFaqs = [
  { title: "More: coffee, breakfast, and a historic tavern", body: "Jeremiah's Coffee House — downtown coffee. Busy Bee — breakfast since 1944. Harmar Tavern — oldest tavern, across the bridge. Spagna's — Italian dinners. Full dining list at mariettamainstreet.org/dining." },
  { title: "Is there anything walkable from the cottage?", body: "Buckeye Park is a two-minute walk. For food, most places are a short drive (5–10 min) into downtown or along Pike Street. No major restaurants are within walking distance of the cottage itself." },
];
const shoppingFaqs = [
  { title: "What's on Pike Street?", body: "Walmart, Kroger, ALDI, Dollar Tree, CVS, Planet Fitness, Ollie's, and Harbor Freight are all clustered on Pike St off I-77 — the main errand corridor for Marietta." },
  { title: "Is there a mall nearby?", body: "Grand Central Mall in Vienna, WV is the only large enclosed mall in the region with 90+ stores. It's across the river, roughly 20 minutes from the cottage." },
];
const hospitalFaqs = [
  { title: "Which hospital is closest?", body: "Marietta Memorial Hospital (401 Matthew St) and Selby General Hospital (1106 Colegate Dr) are both within Marietta city limits. For emergencies always call 911 first." },
  { title: "Is there urgent care nearby?", body: "Yes — check for urgent care clinics on Pike St or near Memorial Hospital. Confirm hours before going as they vary by day." },
];
const parkFaqs = [
  { title: "Is Buckeye Park truly next door?", body: "Yes — Buckeye Park shares the block with Frederick Cottage. You can walk there in under two minutes. It has a fishing pond, softball fields, basketball court, archery range, playground, and a picnic shelter." },
  { title: "What about river access?", body: "Muskingum Park and the Ohio River Levee are both a short drive downtown. Indian Acres Park has a public boat ramp. The Marietta River Trail runs along the riverfront." },
];
const wildlifeFaqs = [
  { title: "When is the best season for wildlife?", body: "Spring (April–May) for migratory birds at Kroger Wetlands. Fall (Sept–Oct) for leaf color in the backyard and surrounding maples. Winter mornings occasionally bring deer to the backyard perimeter." },
  { title: "Where is the best birding spot?", body: "The Kroger Wetlands kiosk trail (0.4-mile loop off Acme St) is the closest dedicated birding spot — free, easy, and well-signed. Best at dawn and dusk." },
];
const essentialsFaqs = [
  { title: "Where is the nearest pharmacy?", body: "Kroger Pharmacy at 40 Acme St and Walmart Pharmacy at 804 Pike St are both within a short drive. CVS and Rite Aid also have locations on Pike St." },
  { title: "Is there a local farmers market?", body: "Huck's Farm Market on Pike St carries local produce. The Marietta Farmers Market runs seasonally downtown — check mariettamainstreet.org for current dates." },
];
const eventsFaqs = [
  { title: "What is the Sternwheel Festival?", body: "The Ohio River Sternwheel Festival is one of the largest sternwheel boat gatherings in the US — held on Marietta's riverfront each September. Free admission, live music, food, and fireworks over the water." },
  { title: "Are there recurring weekly events?", body: "First Friday runs the first Friday of every month, 5–9 pm downtown (shops, music, art walks). RVMBA group bike rides go out the last Monday of each month, Apr–Oct, from 2nd & Butler St." },
];
const transitFaqs = [
  { title: "Do I need a car?", body: "Most guests use a car. The CABL On-Demand service covers Marietta city limits Mon–Fri 7–5 and Saturday mornings. For anything outside the city or outside those hours, a car is needed." },
  { title: "How do I book CABL?", body: "By app or by phone: (740) 373-7671. On-demand rides cost $1 each. Dial-A-Ride for county trips costs $2. Book at least a day ahead for Dial-A-Ride." },
];
---

<ResidenceLayout
  residence={frederick}
  title="Nearby guide · Frederick Cottage | Mt Cottages"
  description="Simple nearby guide for Frederick Cottage in Marietta, OH: trails including Kroger Wetlands and Wayne National Forest, restaurants, shopping, hospitals, Buckeye Park next door, wildlife and seasons, events, transit, and essentials — searchable, with map links."
  eyebrow="Frederick Cottage · Nearby"
  heading="What's around the cottage."
  lede="Short lists, verified names, map links. Tap a map link to check drive time."
>

  <!-- ── HERO CAROUSEL ─────────────────────────────────────── -->
  <HeroCarousel slides={heroSlides} id="nearby-hero" />

  <!-- ── NAV + SEARCH ──────────────────────────────────────── -->
  <section class="section section--paper">
    <div class="site-width">
      <div class="reveal">
        <Breadcrumbs items={[
          { label: "Home",              href: "/" },
          { label: "Marietta",          href: "/marietta/index.html" },
          { label: "Frederick Cottage", href: "/marietta/frederick/index.html" },
          { label: "Nearby",            href: "/marietta/frederick/area.html" },
        ]} />
      </div>
      <nav class="guide-tabs sticky-tabs reveal" aria-label="Nearby guide sections">
        <a href="#trails">Trails</a>
        <a href="#restaurants">Food</a>
        <a href="#shopping">Shopping</a>
        <a href="#hospitals">Hospitals</a>
        <a href="#parks">Parks</a>
        <a href="#wildlife">Wildlife</a>
        <a href="#amenities">Essentials</a>
        <a href="#events">Events</a>
        <a href="#transit">Transit</a>
      </nav>
      <search class="nearby-search reveal">
        <label for="nearby-search">Search this guide</label>
        <input id="nearby-search" type="search" placeholder='Try "wetlands", "Wayne", "Buckeye", "pond", "bus"…' autocomplete="off" />
        <p id="nearby-count" class="nearby-count" aria-live="polite"></p>
      </search>
      <p id="nearby-empty" class="nearby-empty" hidden>No matches. Clear the search to see the full guide.</p>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       TRAILS
  ══════════════════════════════════════════════════════════ -->
  <section class="section" id="trails" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Trails</h2></div></div>
      <p class="section-sub reveal">Where to walk — including wetlands birding and Wayne forest day trips.</p>

      <!-- banner -->
      <div class="nearby-bg-banner reveal" aria-label="Trails near the cottage">
        <div class="nearby-bg-banner-image" aria-hidden="true">
          <ResponsivePhoto {...frederickPhotos.nearbyTrail} widths={[768, 1080, 1600]} sizes="(max-width: 900px) 100vw, 76rem" />
        </div>
        <div class="nearby-bg-banner-copy">
          <p class="eyebrow">Trails · 2 min – day trip</p>
          <h3>Wetlands, river paths, and forest day trips.</h3>
          <p>The Kroger Wetlands loop is 0.4 miles behind the grocery store. The Marietta River Trail runs 3.3 miles along the waterfront. Wayne National Forest is a day trip with 14-mile systems.</p>
          <a class="button button--light" href="https://www.google.com/maps/search/?api=1&query=Kroger+Wetlands+Marietta+OH" rel="noopener">Open wetlands on map ↗</a>
        </div>
      </div>

      <!-- slideout trigger -->
      <div class="cluster mt-3 reveal">
        <button type="button" class="button button--ghost" data-slideout-target="#drawer-trails">Quick trail picks 📂</button>
      </div>

      <!-- split feature -->
      <SplitFeature
        photo={frederickPhotos.nearbyTrail2}
        eyebrow="Trails · Close to home"
        title="A second view of the wooded path."
        body="Many of Marietta's trails are free, easy-access, and within a short drive. The wetlands kiosk trail is the easiest starting point — flat, 0.4 miles, and well-signed."
        ctaHref="https://www.google.com/maps/search/?api=1&query=Marietta+River+Trail+Marietta+OH"
        ctaLabel="River trail map ↗"
        flip={true}
      />

      <ol class="step-grid mt-3">
        <li class="reveal"><strong>Marietta River Trail</strong><p>Paved riverfront path, ~3.3 miles. Indian Acres boat ramp to East 8th. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Marietta+River+Trail+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Kroger Wetlands Trail</strong><p>14.5-acre wetland preserve, ~0.4-mile easy loop behind Kroger off Acme St. Info kiosk, birding, wildflowers. <span class="link-pair"><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kroger+Wetlands+Marietta+OH" rel="noopener">Map ↗</a> <a class="text-link" href="https://mariettaohio.org/directory/kroger-wetlands" rel="noopener">Trail details ↗</a></span></p></li>
        <li class="reveal"><strong>Wayne National Forest – Marietta Unit</strong><p>Day trip. Archer's Fork 14-mile loop, Covered Bridge 5-mile trail, Kinderhook 12-mile system. <span class="link-pair"><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Wayne+National+Forest+Marietta+Unit" rel="noopener">Map ↗</a> <a class="text-link" href="https://rvmba.com/" rel="noopener">Trail group ↗</a></span></p></li>
        <li class="reveal"><strong>Kiwanis Loop</strong><p>Easy 0.8-mile paved loop at Indian Acres Park. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kiwanis+Trail+Indian+Acres+Park+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Marietta Trail Network</strong><p>15+ miles of woods trails for hiking/biking near the high school. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Marietta+Trail+Network+Marietta+High+School+Marietta+OH" rel="noopener">Map ↗</a></p></li>
      </ol>

      <div class="mt-3 reveal"><Accordion items={trailFaqs} openFirst={false} /></div>

      <div class="gallery-grid gallery-grid--even mt-3">
        {[
          { photo: frederickPhotos.nearbyTrail,  label: "01", caption: "Wooded trail near the cottage." },
          { photo: frederickPhotos.nearbyTrail2, label: "02", caption: "Another trail view near the cottage." },
        ].map(({ photo, label, caption }) => (
          <figure class="gallery-item gallery-thumb reveal" data-lightbox-item tabindex="0" role="button" aria-label={`Open photo: ${caption}`}>
            <span class="gallery-thumb-frame">
              <ResponsivePhoto {...photo} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" />
              <span class="gallery-thumb-hover" aria-hidden="true"><strong>{caption}</strong><em>Expand ＋</em></span>
            </span>
            <figcaption><span>{label}</span><div><strong>Trail.</strong> {caption}</div></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Slideout id="drawer-trails" eyebrow="Frederick Cottage · Nearby" title="Quick trail picks">
    <div class="stack">
      <p class="eyebrow">Top picks · confirm conditions before going</p>
      <ul class="checklist">
        <li><strong>Kroger Wetlands</strong> — 0.4-mile easy loop, free, birding kiosk</li>
        <li><strong>Marietta River Trail</strong> — 3.3 miles, paved, riverfront</li>
        <li><strong>Kiwanis Loop</strong> — 0.8 miles, paved, Indian Acres Park</li>
        <li><strong>Marietta Trail Network</strong> — 15+ miles, woods, near high school</li>
        <li><strong>Wayne National Forest</strong> — day trip, 5–14 mile systems</li>
        <li><strong>Broughton's Nature Area</strong> — quiet woods off SR 821</li>
      </ul>
      <a class="button button--ghost" href="https://rvmba.com/" rel="noopener">Trail group details ↗</a>
    </div>
  </Slideout>


  <!-- ══════════════════════════════════════════════════════════
       FOOD
  ══════════════════════════════════════════════════════════ -->
  <section class="section section--paper" id="restaurants" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Food</h2></div></div>
      <p class="section-sub reveal">Where to eat. Confirm hours before going.</p>

      <!-- banner -->
      <div class="nearby-bg-banner reveal" aria-label="Local dining">
        <div class="nearby-bg-banner-image" aria-hidden="true">
          <ResponsivePhoto {...frederickPhotos.nearbyFood} widths={[768, 1080, 1600]} sizes="(max-width: 900px) 100vw, 76rem" />
        </div>
        <div class="nearby-bg-banner-copy">
          <p class="eyebrow">Downtown Marietta · ~5 min drive</p>
          <h3>River views, local kitchens.</h3>
          <p>The Gunroom at Lafayette Hotel, Levee House Bistro on the river, Austyn's, and Boathouse BBQ — all within a short drive of Frederick Cottage.</p>
          <a class="button button--light" href="https://www.mariettamainstreet.org/dining" rel="noopener">Full dining list ↗</a>
        </div>
      </div>

      <!-- slideout trigger -->
      <div class="cluster mt-3 reveal">
        <button type="button" class="button button--ghost" data-slideout-target="#drawer-restaurants">Quick restaurant picks 📂</button>
      </div>

      <!-- split feature -->
      <SplitFeature
        photo={frederickPhotos.nearbyFood2}
        eyebrow="Food · Levee House Bistro"
        title="Steaks, seafood, and a patio on the river."
        body="Levee House Bistro is one of Marietta's most consistent dinner spots — river patio, solid menu, and close enough for a weeknight out."
        ctaHref="https://www.google.com/maps/search/?api=1&query=Levee+House+Bistro+127+Ohio+St+Marietta+OH"
        ctaLabel="Open on map ↗"
      />

      <ol class="step-grid mt-3">
        <li class="reveal"><strong>The Gunroom</strong><p>American, river view, in Lafayette Hotel. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Gunroom+Restaurant+101+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Austyn's</strong><p>Local favorite near the rivers. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Austyn%27s+Restaurant+130+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Levee House Bistro</strong><p>Steaks, seafood, patio on the river. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Levee+House+Bistro+127+Ohio+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Boathouse BBQ</strong><p>BBQ + outdoor tables by the water. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Boathouse+BBQ+218+Virginia+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Over the Moon Pizza</strong><p>Casual pizza pub downtown. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Over+the+Moon+Pub+Pizza+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Tampico + The Galley</strong><p>Mexican (221 2nd St) and American (203 2nd St). <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Tampico+Mexican+Restaurant+Marietta+OH" rel="noopener">Map ↗</a></p></li>
      </ol>

      <div class="mt-3 reveal"><Accordion items={foodFaqs} openFirst={false} /></div>

      <div class="gallery-grid gallery-grid--even mt-3">
        {[
          { photo: frederickPhotos.nearbyFood,  label: "01", caption: "Local restaurant spread near the cottage." },
          { photo: frederickPhotos.nearbyFood2, label: "02", caption: "Levee House Bistro plate near the cottage." },
          { photo: frederickPhotos.nearbyFood3, label: "03", caption: "A third local plate near the cottage." },
          { photo: frederickPhotos.nearbyFood4, label: "04", caption: "Another local plate near the cottage." },
        ].map(({ photo, label, caption }) => (
          <figure class="gallery-item gallery-thumb reveal" data-lightbox-item tabindex="0" role="button" aria-label={`Open photo: ${caption}`}>
            <span class="gallery-thumb-frame">
              <ResponsivePhoto {...photo} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" />
              <span class="gallery-thumb-hover" aria-hidden="true"><strong>{caption}</strong><em>Expand ＋</em></span>
            </span>
            <figcaption><span>{label}</span><div><strong>Local flavor.</strong> {caption}</div></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Slideout id="drawer-restaurants" eyebrow="Frederick Cottage · Nearby" title="Quick restaurant picks">
    <div class="stack">
      <p class="eyebrow">Top 6 picks · confirm hours before going</p>
      <ul class="checklist">
        <li><strong>The Gunroom</strong> — American, river view, Lafayette Hotel</li>
        <li><strong>Levee House Bistro</strong> — Steaks, seafood, river patio</li>
        <li><strong>Austyn's</strong> — Local favorite near the rivers</li>
        <li><strong>Boathouse BBQ</strong> — BBQ + outdoor tables by the water</li>
        <li><strong>Over the Moon Pizza</strong> — Casual pizza pub downtown</li>
        <li><strong>Tampico</strong> — Mexican, 221 2nd St</li>
      </ul>
      <a class="button button--ghost" href="https://www.mariettamainstreet.org/dining" rel="noopener">Full dining list ↗</a>
    </div>
  </Slideout>


  <!-- ══════════════════════════════════════════════════════════
       SHOPPING
  ══════════════════════════════════════════════════════════ -->
  <section class="section" id="shopping" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Shopping</h2></div></div>
      <p class="section-sub reveal">Where to shop. Daily needs on Pike St off I-77.</p>

      <!-- banner -->
      <div class="nearby-bg-banner reveal" aria-label="Shopping near the cottage">
        <div class="nearby-bg-banner-image" aria-hidden="true">
          <ResponsivePhoto {...frederickPhotos.nearbyShopping} widths={[768, 1080, 1600]} sizes="(max-width: 900px) 100vw, 76rem" />
        </div>
        <div class="nearby-bg-banner-copy">
          <p class="eyebrow">Shopping · Pike St off I-77</p>
          <h3>Everything you need on one corridor.</h3>
          <p>Walmart grocery pickup, Kroger with pharmacy, ALDI, Dollar Tree, and more — all clustered on Pike Street, a short drive from the cottage.</p>
          <a class="button button--light" href="https://www.google.com/maps/search/?api=1&query=Walmart+Kroger+Pike+Street+Marietta+OH" rel="noopener">Open on map ↗</a>
        </div>
      </div>

      <!-- slideout trigger -->
      <div class="cluster mt-3 reveal">
        <button type="button" class="button button--ghost" data-slideout-target="#drawer-shopping">Quick shopping picks 📂</button>
      </div>

      <!-- split feature -->
      <SplitFeature
        photo={frederickPhotos.nearbyMall}
        eyebrow="Shopping · Grand Central Mall"
        title="Grand Central Mall in Vienna, WV"
        body="Grand Central Mall in Vienna, WV has 90+ stores including major anchors — about 20 minutes from the cottage across the river."
        ctaHref="https://www.google.com/maps/search/?api=1&query=Grand+Central+Mall+Vienna+WV"
        ctaLabel="Open on map ↗"
        flip={true}
      />

      <ol class="step-grid mt-3">
        <li class="reveal"><strong>Lafayette Plaza</strong><p>Pike St. Ollie's, Harbor Freight, Planet Fitness. Across from Kroger. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Lafayette+Plaza+Pike+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Walmart + Kroger</strong><p>804 Pike St and 40 Acme St. Groceries + pharmacy. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Walmart+Kroger+Pike+Street+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Grand Central Mall</strong><p>Vienna, WV. Only big enclosed mall nearby, 90+ stores. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Grand+Central+Mall+Vienna+WV" rel="noopener">Map ↗</a></p></li>
      </ol>

      <div class="mt-3 reveal"><Accordion items={shoppingFaqs} openFirst={false} /></div>

      <div class="gallery-grid gallery-grid--even mt-3">
        {[
          { photo: frederickPhotos.nearbyShopping, label: "01", caption: "Walmart grocery pickup entrance for daily shopping." },
          { photo: frederickPhotos.nearbyMall,     label: "02", caption: "Grand Central Mall near the cottage." },
        ].map(({ photo, label, caption }) => (
          <figure class="gallery-item gallery-thumb reveal" data-lightbox-item tabindex="0" role="button" aria-label={`Open photo: ${caption}`}>
            <span class="gallery-thumb-frame">
              <ResponsivePhoto {...photo} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" />
              <span class="gallery-thumb-hover" aria-hidden="true"><strong>{caption}</strong><em>Expand ＋</em></span>
            </span>
            <figcaption><span>{label}</span><div>{caption}</div></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Slideout id="drawer-shopping" eyebrow="Frederick Cottage · Nearby" title="Quick shopping picks">
    <div class="stack">
      <p class="eyebrow">Daily errands · all on Pike St or nearby</p>
      <ul class="checklist">
        <li><strong>Walmart</strong> — 804 Pike St, grocery pickup available</li>
        <li><strong>Kroger</strong> — 40 Acme St, full grocery + pharmacy</li>
        <li><strong>ALDI</strong> — Pike St, budget groceries</li>
        <li><strong>Ollie's Bargain Outlet</strong> — Lafayette Plaza, Pike St</li>
        <li><strong>Harbor Freight</strong> — Lafayette Plaza, Pike St</li>
        <li><strong>Grand Central Mall</strong> — Vienna, WV, 90+ stores</li>
      </ul>
    </div>
  </Slideout>


  <!-- ══════════════════════════════════════════════════════════
       HOSPITALS
  ══════════════════════════════════════════════════════════ -->
  <section class="section section--paper" id="hospitals" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Hospitals</h2></div></div>
      <p class="section-sub reveal">If you need care. Emergency? Call 911.</p>

      <!-- banner -->
      <div class="nearby-bg-banner reveal" aria-label="Hospitals near the cottage">
        <div class="nearby-bg-banner-image" aria-hidden="true">
          <ResponsivePhoto {...frederickPhotos.nearbyHospital} widths={[768, 1080, 1600]} sizes="(max-width: 900px) 100vw, 76rem" />
        </div>
        <div class="nearby-bg-banner-copy">
          <p class="eyebrow">Hospitals · Within Marietta city limits</p>
          <h3>Two hospitals within the city. 911 first for emergencies.</h3>
