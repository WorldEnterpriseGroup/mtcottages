---
import ResidenceLayout from "../../../layouts/ResidenceLayout.astro";
import ResponsivePhoto from "../../../components/ResponsivePhoto.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DrillRail from "../../../components/DrillRail.astro";
import ScrollDepth from "../../../components/ScrollDepth.astro";
import { frederick, frederickPhotos } from "../../../data/residences/frederick";
---

<ResidenceLayout
  residence={frederick}
  title="Nearby guide · Frederick Cottage | Mt Cottages"
  description="Simple nearby guide for Frederick Cottage in Marietta, OH: trails including Kroger Wetlands and Wayne National Forest, restaurants, shopping, hospitals, Buckeye Park next door, wildlife and seasons, events, transit, and essentials — searchable, with map links."
  eyebrow="Frederick Cottage · Nearby"
  heading="What's around the cottage."
  lede="Short lists, verified names, map links. Tap a map link to check drive time."
>
  <section class="section section--paper">
    <div class="site-width">
      <div class="reveal">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Marietta", href: "/marietta/index.html" }, { label: "Frederick Cottage", href: "/marietta/frederick/index.html" }, { label: "Nearby", href: "/marietta/frederick/area.html" }]} />
      </div>
      <nav class="guide-tabs sticky-tabs reveal" aria-label="Nearby guide sections">
        <a href="#trails">Trails</a>
        <a href="#restaurants">Food</a>
        <a href="#shopping">Shopping</a>
        <a href="#hospitals">Hospitals</a>
        <a href="#parks">Parks</a>
        <a href="#wildlife">Wildlife</a>
        <a href="#amenities">Essentials</a>
        <a href="#events">Events</a>
        <a href="#transit">Transit</a>
      </nav>
      <search class="nearby-search reveal">
        <label for="nearby-search">Search this guide</label>
        <input id="nearby-search" type="search" placeholder="Try “wetlands”, “Wayne”, “Buckeye”, “pond”, “bus”… " autocomplete="off" />
        <p id="nearby-count" class="nearby-count" aria-live="polite"></p>
      </search>
      <p id="nearby-empty" class="nearby-empty" hidden>No matches. Clear the search to see the full guide.</p>
    </div>
  </section>

  <section class="section" id="trails" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Trails</h2></div></div>
      <p class="section-sub reveal">Where to walk — including wetlands birding and Wayne forest day trips.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Marietta River Trail</strong><p>Paved riverfront path, ~3.3 miles. Indian Acres boat ramp to East 8th. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Marietta+River+Trail+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Kroger Wetlands Trail</strong><p>14.5-acre wetland preserve, ~0.4-mile easy loop behind Kroger off Acme St. Info kiosk, birding, wildflowers, wildlife viewpoints. <span class="link-pair"><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kroger+Wetlands+Marietta+OH" rel="noopener">Map ↗</a> <a class="text-link" href="https://mariettaohio.org/directory/kroger-wetlands" rel="noopener">Trail details ↗</a></span></p></li>
        <li class="reveal"><strong>Wayne National Forest – Marietta Unit</strong><p>Day trip. Archer's Fork 14-mile loop (Irish Run Natural Bridge), Covered Bridge 5-mile trail, Kinderhook 12-mile system. <span class="link-pair"><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Wayne+National+Forest+Marietta+Unit+Athens+Ranger+District" rel="noopener">Map ↗</a> <a class="text-link" href="https://rvmba.com/" rel="noopener">Trail group ↗</a></span></p></li>
        <li class="reveal"><strong>Kiwanis Loop</strong><p>Easy 0.8-mile paved loop at Indian Acres Park. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kiwanis+Trail+Indian+Acres+Park+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Marietta Trail Network</strong><p>15+ miles of woods trails for hiking/biking. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Marietta+Trail+Network+Marietta+High+School+Marietta+OH" rel="noopener">Map ↗</a></p></li>
      </ol>
      <div class="faq mt-3 reveal"><details><summary>More trails (Broughton)</summary><p><strong>Broughton's Nature Area</strong> — quiet woods trails off SR 821. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Broughton+Nature+Wildlife+Area+Marietta+OH" rel="noopener">Map ↗</a></p></details></div>
      <div class="gallery-grid gallery-grid--even">
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyTrail} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>01</span><div><strong>Trail.</strong> Wooded trail near the cottage.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyTrail2} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>02</span><div><strong>Trail view.</strong> Another trail near the cottage.</div></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--paper" id="restaurants" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Food</h2></div></div>
      <p class="section-sub reveal">Where to eat. Confirm hours before going.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>The Gunroom</strong><p>American, river view, in Lafayette Hotel. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Gunroom+Restaurant+101+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Austyn's</strong><p>Local favorite near the rivers. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Austyn%27s+Restaurant+130+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Levee House Bistro</strong><p>Steaks, seafood, patio on the river. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Levee+House+Bistro+127+Ohio+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Boathouse BBQ</strong><p>BBQ + outdoor tables by the water. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Boathouse+BBQ+218+Virginia+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Over the Moon Pizza</strong><p>Casual pizza pub downtown. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Over+the+Moon+Pub+Pizza+Front+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Tampico + The Galley</strong><p>Mexican (221 2nd St) and American (203 2nd St). <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Tampico+Mexican+Restaurant+Marietta+OH" rel="noopener">Map ↗</a></p></li>
      </ol>
      <div class="faq mt-3 reveal"><details><summary>More: coffee, breakfast, tavern</summary><p><strong>Jeremiah's Coffee House</strong> — downtown coffee. <strong>Busy Bee</strong> — breakfast since 1944. <strong>Harmar Tavern</strong> — oldest tavern, across the bridge. <strong>Spagna's</strong> — Italian dinners. <a class="text-link" href="https://www.mariettamainstreet.org/dining" rel="noopener">Full dining list ↗</a></p></details></div>
      <div class="gallery-grid gallery-grid--even">
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyFood} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>01</span><div><strong>Local flavor.</strong> Restaurant spread near the cottage.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyFood2} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>02</span><div><strong>Levee House Bistro.</strong> Another plate near the cottage.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyFood3} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>03</span><div><strong>Third plate.</strong> Another local dish near the cottage.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyFood4} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>04</span><div><strong>Fourth plate.</strong> Another local dish near the cottage.</div></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section" id="shopping" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Shopping</h2></div></div>
      <p class="section-sub reveal">Where to shop. Daily needs on Pike St off I-77.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Lafayette Plaza</strong><p>Pike St. Ollie's, Harbor Freight, Planet Fitness. Across from Kroger. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Lafayette+Plaza+Pike+St+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Walmart + Kroger</strong><p>804 Pike St and 40 Acme St. Groceries + pharmacy. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Walmart+Kroger+Pike+Street+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Grand Central Mall</strong><p>Vienna, WV. Only big enclosed mall nearby, 90+ stores. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Grand+Central+Mall+Vienna+WV" rel="noopener">Map ↗</a></p></li>
      </ol>
      <div class="gallery-grid gallery-grid--even">
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyShopping} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>01</span><div><strong>Pickup.</strong> Walmart grocery pickup entrance for daily shopping.</div></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--paper" id="hospitals" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Hospitals</h2></div></div>
      <p class="section-sub reveal">If you need care. Emergency? Call 911.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Marietta Memorial Hospital</strong><p>401 Matthew St · (740) 374-1400. Main hospital + ER. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Marietta+Memorial+Hospital+401+Matthew+Street+Marietta+OH" rel="noopener">Directions ↗</a></p></li>
        <li class="reveal"><strong>Selby General Hospital</strong><p>1106 Colegate Dr · (740) 568-2000. Hospital + ER. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Selby+General+Hospital+1106+Colegate+Drive+Marietta+OH" rel="noopener">Directions ↗</a></p></li>
      </ol>
      <div class="gallery-grid gallery-grid--even">
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyHospital} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>01</span><div><strong>Lobby.</strong> Selby General Hospital reception and front desk.</div></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section" id="parks" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Parks</h2></div></div>
      <p class="section-sub reveal">Green time. Buckeye Park sits right beside Frederick Cottage.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Buckeye Park — next door to the cottage</strong><p>Walk to the playground, fishing pond, softball fields, basketball court, archery range, and picnic shelter. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Buckeye+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>Muskingum Park</strong><p>Riverfront + monument. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Muskingum+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>East Muskingum Park</strong><p>Pavilion + gazebo, river views. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=East+Muskingum+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>Gold Star Park</strong><p>Disc golf, tennis/pickleball. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Gold+Star+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>Indian Acres Park</strong><p>Boat ramp, skate park, pool. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Indian+Acres+Park+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
        <li class="reveal"><strong>Ohio River Levee</strong><p>Levee walks + festival grounds. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Ohio+River+Levee+Marietta+OH" rel="noopener">Photos & map ↗</a></p></li>
      </ol>
      <div class="gallery-grid gallery-grid--even">
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.buckeyeFields} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>01</span><div><strong>Fields.</strong> Buckeye Park sports fields at dusk.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.buckeyeShelter} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>02</span><div><strong>Shelter.</strong> Buckeye Park picnic shelter by the pond.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.buckeyePlayground} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>03</span><div><strong>Playground.</strong> Buckeye Park playground and lawn.</div></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--paper" id="wildlife" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Wildlife & seasons</h2></div></div>
      <p class="section-sub reveal">What the year looks like from the cottage and nearby wetlands.</p>
      <div class="gallery-grid gallery-grid--even">
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.exteriorFrontLawn} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>01</span><div><strong>Summer.</strong> Front porch, picket fence, and lawn in leaf.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.exterior} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>02</span><div><strong>Fall leaves.</strong> Backyard maples and fence-line color.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.exteriorFrontSnow} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>03</span><div><strong>Snow.</strong> Covered front porch after a snowfall.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.wildlifeWoods} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>04</span><div><strong>Trees.</strong> Dense trees with early fall color.</div></figcaption></figure>
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.wildlifeLeaves} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>05</span><div><strong>Fallen leaves.</strong> Maple leaves near the cottage.</div></figcaption></figure>
      </div>
      <ol class="step-grid mt-3">
        <li class="reveal"><strong>Birds & wildlife to watch for</strong><p>Backyard trees and the Kroger Wetlands kiosk trail draw everyday Ohio birds, squirrels, and pond wildlife — best at morning and dusk. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kroger+Wetlands+Marietta+OH" rel="noopener">Wetland birding map ↗</a></p><p class="photo-gap">Wildlife close-ups pending Wardah review — no stock or invented animal photos added.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="amenities" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Essentials</h2></div></div>
      <p class="section-sub reveal">Groceries, pharmacy, library.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Groceries</strong><p>Kroger, Walmart, ALDI on Pike/Acme. Huck's Farm Market for local produce. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kroger+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Pharmacy</strong><p>Kroger Pharmacy + Walmart Pharmacy on site. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=pharmacy+Pike+Street+Marietta+OH" rel="noopener">Map ↗</a></p></li>
        <li class="reveal"><strong>Library</strong><p>615 Fifth St. Free wi-fi, computers. Mon–Thu 9–7, Fri 9–6, Sat 10–2. <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Washington+County+Public+Library+Marietta+OH" rel="noopener">Map ↗</a></p></li>
      </ol>
      <div class="gallery-grid gallery-grid--even">
        <figure class="gallery-item reveal"><ResponsivePhoto {...frederickPhotos.nearbyEssentials} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption><span>01</span><div><strong>Groceries + pharmacy.</strong> Kroger storefront with pharmacy entrance.</div></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--paper" id="events" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Events</h2></div></div>
      <p class="section-sub reveal">Worth timing. Confirm dates yearly — downtown fills fast.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>Sternwheel Festival</strong><p>Riverfront · Sept 11–13, 2026. Boats, music, fireworks. Free. <a class="text-link" href="https://sternwheel.org/" rel="noopener">Details ↗</a></p></li>
        <li class="reveal"><strong>First Friday</strong><p>Downtown · first Friday monthly, 5–9pm. Shops + music. <a class="text-link" href="https://www.mariettamainstreet.org/first-fridays" rel="noopener">Details ↗</a></p></li>
        <li class="reveal"><strong>Group bike rides</strong><p>Last Monday monthly, Apr–Oct, 5:30pm. 2nd & Butler St. Hosted by RVMBA. <a class="text-link" href="https://rvmba.com/" rel="noopener">Ride details ↗</a></p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="transit" data-nearby-section>
    <div class="site-width">
      <div class="section-heading reveal"><div><h2>Transit</h2></div></div>
      <p class="section-sub reveal">Getting around. No fixed bus routes — CABL picks you up at your curb. Most guests use a car.</p>
      <ol class="step-grid">
        <li class="reveal"><strong>CABL On-Demand</strong><p>Mon–Fri 7–5, Sat morning–1. $1/ride. Book: app or (740) 373-7671. <a class="text-link" href="http://www.wmcap.org/transportation" rel="noopener">How to book ↗</a></p></li>
        <li class="reveal"><strong>CABL Dial-A-Ride</strong><p>For trips outside Marietta, anywhere in the county. $2/ride. Same number. <a class="text-link" href="http://www.wmcap.org/transportation" rel="noopener">Details ↗</a></p></li>
      </ol>
      <div class="mt-3 reveal">
        <DrillRail
          up={{ eyebrow: "Level 2 · Up", label: "Frederick home", href: "/marietta/frederick/index.html", description: "Back to the microsite hub." }}
          prev={{ eyebrow: "Level 3 · Sideways", label: "Gallery + outdoors", href: "/marietta/frederick/gallery.html", description: "Every room photo in one place." }}
          next={{ eyebrow: "Level 3 · Next", label: "Arrival + handbook", href: "/marietta/frederick/arrival.html", description: "How to arrive without guesswork." }}
        />
      </div>
    </div>
  </section>
  <ScrollDepth />
</ResidenceLayout>

<script>
  const input = document.getElementById("nearby-search");
  const count = document.getElementById("nearby-count");
  const empty = document.getElementById("nearby-empty");
  const sections = Array.from(document.querySelectorAll("[data-nearby-section]"));
  const cards = sections.flatMap((section) =>
    Array.from(section.querySelectorAll("ol.step-grid > li, .gallery-grid > figure")).map((el) => ({ section, el }))
  );

  function applyFilter() {
    const q = (input.value || "").trim().toLowerCase();
    let visible = 0;
    for (const { el } of cards) {
      const hit = !q || (el.textContent || "").toLowerCase().includes(q);
      el.hidden = !hit;
      if (hit) visible += 1;
    }
    for (const section of sections) {
      const items = section.querySelectorAll("ol.step-grid > li, .gallery-grid > figure");
      const anyVisible = Array.from(items).some((el) => !el.hidden);
      section.hidden = q ? !anyVisible : false;
    }
    if (count) count.textContent = q ? `${visible} match${visible === 1 ? "" : "es"} for “${input.value.trim()}”` : "";
    if (empty) empty.hidden = !q || visible > 0;
  }

  if (input) input.addEventListener("input", applyFilter);
</script>

<style>
  .guide-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    align-items: stretch;
  }
  .guide-tabs a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.75rem 0.5rem;
    color: var(--forest);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0.8rem;
  }
  .guide-tabs a:hover {
    border-color: var(--accent);
  }
  .nearby-search {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
  }
  .nearby-search label {
    font-weight: 800;
    color: var(--forest);
  }
  .nearby-search input[type="search"] {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 1.05rem;
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: #fff;
    color: var(--ink);
  }
  .nearby-count {
    margin: 0;
    color: var(--forest);
    font-weight: 600;
  }
  .nearby-count:empty {
    display: none;
  }
  .nearby-empty {
    margin: 0.75rem 0 0;
    padding: 1rem;
    border: 1px dashed var(--line);
    border-radius: 0.8rem;
    background: #fff;
  }
  ol.step-grid {
    align-items: stretch;
  }
  ol.step-grid > li {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.1rem;
  }
  ol.step-grid > li::before {
    margin: 0;
  }
  ol.step-grid strong {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }
  ol.step-grid p {
    margin: 0;
    max-width: none;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  ol.step-grid p + p {
