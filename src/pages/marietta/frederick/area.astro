<script>
  const input = document.getElementById("nearby-search") as HTMLInputElement | null;
  const count = document.getElementById("nearby-count");
  const empty = document.getElementById("nearby-empty");
  const sections = Array.from(document.querySelectorAll("[data-nearby-section]"));
  const cards = sections.flatMap((section) =>
    Array.from(section.querySelectorAll("ol.step-grid > li, .gallery-grid > figure")).map((el) => ({ section, el }))
  );

  function applyFilter() {
    const q = (input?.value || "").trim().toLowerCase();
    let visible = 0;
    for (const { el } of cards) {
      const hit = !q || (el.textContent || "").toLowerCase().includes(q);
      (el as HTMLElement).hidden = !hit;
      if (hit) visible += 1;
    }
    for (const section of sections) {
      const items = section.querySelectorAll("ol.step-grid > li, .gallery-grid > figure");
      const anyVisible = Array.from(items).some((el) => !(el as HTMLElement).hidden);
      (section as HTMLElement).hidden = q ? !anyVisible : false;
    }
    if (count) count.textContent = q ? `${visible} match${visible === 1 ? "" : "es"} for "${input?.value.trim()}"` : "";
    if (empty) (empty as HTMLElement).hidden = !q || visible > 0;
  }

  if (input) input.addEventListener("input", applyFilter);
</script>


