---
import ResidenceLayout from "../../../layouts/ResidenceLayout.astro";
import ResponsivePhoto from "../../../components/ResponsivePhoto.astro";
import TrustStrip from "../../../components/TrustStrip.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DrillRail from "../../../components/DrillRail.astro";
import ScrollDepth from "../../../components/ScrollDepth.astro";
import { frederick, frederickPhotos } from "../../../data/residences/frederick";
---

<ResidenceLayout
  residence={frederick}
  title="Frederick Cottage · Marietta Research Residence | Mt Cottages"
  description="Frederick Cottage in Marietta, OH: a three-bedroom furnished Research Residence with kitchen, living and work space, outdoor setting, handbook, and nearby recreation."
  eyebrow="Marietta, OH · Research Residence"
  heading="A Marietta home with room for the whole assignment."
  lede="Three bedrooms, a working kitchen, places to gather and focus, and a calm street to come home to."
>
  <TrustStrip />

  <div class="site-width mt-2 reveal">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Marietta", href: "/marietta/index.html" }, { label: "Frederick Cottage", href: "/marietta/frederick/index.html" }]} />
  </div>

  <section class="section section--paper">
    <div class="site-width">
      <div class="section-heading reveal">
        <div><p class="eyebrow">At a glance</p><h2>Quick details.</h2></div>
      </div>
      <aside class="details-panel reveal" aria-label="Frederick Cottage quick details">
        <div class="details-grid details-grid--wide">
          {frederick.facts.map((fact) => <div class="detail"><span class="detail-label">{fact.label}</span><span class="detail-value">{fact.value}</span></div>)}
        </div>
        <div class="cluster"><a class="button" href="/apply.html?property=frederick">Ask about this home ↗</a><a class="button button--ghost" href="/marietta/frederick/arrival.html">Plan arrival</a></div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="site-width">
      <div class="section-heading reveal">
        <div><p class="eyebrow">The story</p><h2>A spacious home that settles quickly.</h2></div>
      </div>
      <div class="editorial">
        <div class="stack reveal">
          <h3>Sleep, cook, gather, reset.</h3>
          <ul class="checklist">
            <li>Three distinct bedrooms for rest, work overflow, or family rhythm.</li>
            <li>Full kitchen with oak cabinets for everyday meals, not takeout endurance.</li>
            <li>Sitting room plus dining/entry for gathering, remote work, and quiet corners.</li>
          </ul>
          <div class="cluster"><a class="button" href="/marietta/frederick/gallery.html">Tour the cottage</a></div>
        </div>
        <figure class="reveal reveal--image"><ResponsivePhoto {...frederickPhotos.living} sizes="(max-width: 900px) 100vw, 45vw" /><figcaption class="sr-only">{frederickPhotos.living.alt}</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="site-width">
      <div class="section-heading reveal">
        <div><p class="eyebrow">Room previews</p><h2>Each space is its own destination.</h2></div>
      </div>
      <div class="room-grid stagger">
        <article class="room-card reveal"><figure><ResponsivePhoto {...frederickPhotos.primaryBedroom} sizes="(max-width: 900px) 100vw, 30vw" /></figure><div><h3>Bedroom 1</h3><a class="text-link" href="/marietta/frederick/rooms.html">See Bedroom Photos</a></div></article>
        <article class="room-card reveal"><figure><ResponsivePhoto {...frederickPhotos.bathroom} sizes="(max-width: 900px) 100vw, 30vw" /></figure><div><h3>Bathroom</h3><a class="text-link" href="/marietta/frederick/bathrooms.html">See Bathroom Photos</a></div></article>
        <article class="room-card reveal"><figure><ResponsivePhoto {...frederickPhotos.kitchen} sizes="(max-width: 900px) 100vw, 30vw" /></figure><div><h3>Kitchen</h3><a class="text-link" href="/marietta/frederick/kitchen.html">See Kitchen Photos</a></div></article>
        <article class="room-card reveal"><figure><ResponsivePhoto {...frederickPhotos.dining} sizes="(max-width: 900px) 100vw, 30vw" /></figure><div><h3>Dining & entry</h3><a class="text-link" href="/marietta/frederick/living.html">See Dining Photos</a></div></article>
        <article class="room-card reveal"><figure><ResponsivePhoto {...frederickPhotos.exterior} sizes="(max-width: 900px) 100vw, 30vw" /></figure><div><h3>Exterior / outdoors</h3><a class="text-link" href="/marietta/frederick/outdoors.html">See Exterior Photos</a></div></article>
      </div>
      <div class="mt-3 reveal">
        <DrillRail
          up={{ eyebrow: "Level 1 · Up", label: "Marietta guide", href: "/marietta/index.html", description: "Town context around the cottage." }}
          prev={{ eyebrow: "Level 3 · Deeper", label: "Kitchen + living", href: "/marietta/frederick/kitchen.html", description: "Cook, gather, and work corners." }}
          next={{ eyebrow: "Level 3 · Deepest", label: "Nearby guide", href: "/marietta/frederick/area.html", description: "Trails, food, parks, and essentials." }}
        />
      </div>
    </div>
  </section>
  <ScrollDepth />
</ResidenceLayout>
