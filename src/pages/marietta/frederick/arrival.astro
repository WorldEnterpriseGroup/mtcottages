---
import ResidenceLayout from "../../../layouts/ResidenceLayout.astro";
import { frederick } from "../../../data/residences/frederick";
---

<style>
  .section-sub {
    margin: 0.25rem 0 0;
    font-size: 1.05rem;
  }
  .map-frame {
    margin: 1rem 0 0;
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
  }
  .map-frame iframe {
    display: block;
    width: 100%;
    height: 420px;
    border: 0;
  }
  @media (max-width: 700px) {
    .map-frame iframe {
      height: 300px;
    }
  }
</style>

<ResidenceLayout
  residence={frederick}
  title="Arrival & map · Frederick Cottage | Mt Cottages"
  description="How to arrive at Frederick Cottage in Marietta: what to share, what to expect, and how the home stays private."
  eyebrow="Frederick Cottage · Arrival & map"
  heading="Arrive without guesswork."
  lede="Know the setting before day one, plus a short confirmation checklist — so arrival feels planned, not improvised."
>
  <section class="section section--paper">
    <div class="site-width">
      <div class="stack reveal">
        <h2>Where you&rsquo;ll be.</h2>
        <p class="section-sub">Marietta, Ohio, United States.</p>
      </div>
      <figure class="map-frame reveal">
        <iframe title="Map of 125 Frederick St, Marietta, OH" src="https://www.google.com/maps?q=125+Frederick+St,+Marietta,+OH+45750&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </figure>
      <p class="reveal" style="margin-top:1rem"><strong>Frederick Cottage</strong><br />125 Frederick St, Marietta, OH 45750</p>
    </div>
  </section>

  <section class="section">
    <div class="site-width split">
      <div class="faq reveal">
        <details open><summary>Where do I park?</summary><p>Parking varies by home and arrangement. Confirm spaces, street rules, and winter notes in the pre-arrival message.</p></details>
        <details><summary>What time can I arrive?</summary><p>Arrival windows are arranged per stay. Share travel timing early so the team can plan keys and walkthrough.</p></details>
        <details><summary>Can I arrive early or leave late?</summary><p>Luggage dropoff is allowed for early arrival or late departure. Confirm timing in the pre-arrival message so keys and walkthrough stay planned.</p></details>
      </div>
    </div>
  </section>
</ResidenceLayout>
