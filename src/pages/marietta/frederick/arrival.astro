---
import ResidenceLayout from "../../../layouts/ResidenceLayout.astro";
import { frederick, frederickPhotos } from "../../../data/residences/frederick";
---

<ResidenceLayout
  residence={frederick}
  title="Arrival & map · Frederick Cottage | Mt Cottages"
  description="How to arrive at Frederick Cottage in Marietta: what to share, what to expect, and how the home stays private."
  eyebrow="Frederick Cottage · Arrival & map"
  heading="Arrive without guesswork."
  lede="Know the setting before day one, plus a short confirmation checklist — so arrival feels planned, not improvised."
  hero={frederickPhotos.exteriorFrontDrive}
>
  <section class="section section--paper">
    <div class="site-width stack reveal">
      <h2>Where You'll Be.</h2>
      <p>Marietta, Ohio, United States.</p>
      <figure class="map-frame">
        <iframe
          title="Map of Frederick Cottage, Marietta, Ohio"
          src="https://www.google.com/maps?q=125+Frederick+St,+Marietta,+OH+45750&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </figure>
      <p><strong>Frederick Cottage</strong><br />125 Frederick St, Marietta, OH 45750</p>
    </div>
  </section>

  <section class="section">
    <div class="site-width faq reveal">
      <details open><summary>Where do I park?</summary><p>Parking varies by home and arrangement. Confirm spaces, street rules, and winter notes in the pre-arrival message.</p></details>
      <details><summary>What time can I arrive?</summary><p>Arrival windows are arranged per stay. Share travel timing early so the team can plan keys and walkthrough.</p></details>
      <details><summary>Can I arrive early or leave late?</summary><p>Early arrivals and late departures depend on the turnover between stays. Share your timing in the inquiry and confirm the window before day one.</p></details>
    </div>
  </section>
</ResidenceLayout>
