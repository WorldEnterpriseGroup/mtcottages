---
import BaseLayout from "../layouts/BaseLayout.astro";
import ApplicationForm from "../components/ApplicationForm.astro";
---

<BaseLayout title="Apply for a cottage" description="Start an application for a furnished cottage, apartment, or house with M&T Cottages.">
  <section class="utility-page shell application-intro"><div><p class="eyebrow">Start here</p><h1>Tell us what you need. We’ll help you find the fit.</h1><p class="lede">This is an inquiry and application—not a lease, approval, or guarantee of housing. Share what you need and we will follow up with current availability and the right next step.</p><p><strong>Please do not enter Social Security numbers, payment-card details, bank information, or other highly sensitive documents.</strong></p><p>Questions first? Email <a class="text-link" href="mailto:stay@mtcottages.com">stay@mtcottages.com</a>.</p></div><ApplicationForm /></section>
  <section class="section section-tone"><div class="shell split-callout"><div><p class="eyebrow">What to have ready</p><h2>A few simple details.</h2></div><div class="list-rows"><div class="list-row"><span>Where you need to stay</span><span>Marietta · Parkersburg · Ravenswood</span></div><div class="list-row"><span>When you need it</span><span>Move-in date and duration</span></div><div class="list-row"><span>Who is staying</span><span>Household and pets</span></div><div class="list-row"><span>What you need</span><span>Bedroom count and budget</span></div></div></div></section>
</BaseLayout>
