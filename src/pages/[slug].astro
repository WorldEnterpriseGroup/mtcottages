---
import EditorialPage from "../components/EditorialPage.astro";
import { contentPages } from "../data/pages";

export function getStaticPaths() {
  return Object.entries(contentPages).map(([slug, page]) => ({ params: { slug }, props: { page } }));
}

const { page } = Astro.props;
---

<EditorialPage title={page.title} description={page.description} heading={page.heading} copy={page.copy} />
