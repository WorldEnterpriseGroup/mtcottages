---
/**
 * Home page (#21): built around the brand promise in docs/marketing/brand-and-positioning.md.
 * Hero (promise, the three towns, Check dates), an audience router to each hub, the live
 * homes by town, and two pillars: "Whole home, nothing to add" and "Minutes, not miles".
 *
 * Live homes only. Yellow is not ready and Walnut gets no microsite (CEO decisions
 * 2026-11-14), so neither is marketed here; both keep their pages on cottages.html.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import ResponsivePhoto from "../components/ResponsivePhoto.astro";
import CheckDates from "../components/CheckDates.astro";
import { cottages, publishedLuxuryFurnishedRates, type Cottage } from "../data/site";
import { homes as microsites } from "../data/homes";
import { hasStreetAddress } from "../data/homes/links";
import { distancesFor } from "../data/distances";
import homeHero from "../../assets/images/cottages/marietta-01/frederick-exterior-full-safe.avif";
import frederickKitchen from "../../assets/images/cottages/marietta-01/gallery-01.jpg";
import frederickBackyard from "../../assets/images/cottages/marietta-01/frederick-backyard-cover.jpg";
import oakBedroom from "../../assets/images/cottages/parkersburg-04/photo-07.avif";
import oakDining from "../../assets/images/cottages/parkersburg-04/homepage-hero-oak-dining.avif";
import henriettaLaundry from "../../assets/images/cottages/ravenswood-03/unique/available-img-428-c44a6dc5bc-648x470.avif";
import virginiaLiving from "../../assets/images/cottages/ravenswood-02/photo-117.avif";

const home = (id: string): Cottage => {
  const cottage = cottages.find((entry) => entry.id === id);
  if (!cottage) throw new Error(`Home page lists "${id}", which is not in src/data/site.ts`);
  return cottage;
};

const towns = [
  {
    id: "marietta",
    name: "Marietta, Ohio",
    short: "Marietta, Ohio",
    guide: "/marietta/index.html",
    note: "Brick streets where the Muskingum meets the Ohio, Marietta College, and Memorial Health System across town.",
    photo: { src: frederickBackyard, alt: "Frederick Cottage backyard with lawn, white picket fence, patio seating and autumn trees" },
    homes: ["frederick"].map(home),
  },
  {
    id: "parkersburg",
    name: "Parkersburg, West Virginia",
    short: "Parkersburg, WV",
    guide: "/parkersburg/index.html",
    note: "The valley’s largest town, with WVU Medicine Camden Clark, the riverfront City Park and Blennerhassett Island a ferry ride away.",
    photo: { src: oakDining, alt: "Oak Cottage dining room with a blue table, white chairs and a bright window" },
    homes: ["broad", "buck", "oak"].map(home),
  },
  {
    id: "ravenswood",
    name: "Ravenswood, West Virginia",
    short: "Ravenswood, WV",
    guide: "/ravenswood/index.html",
    note: "A small river town upstream, a quiet base for Jackson County and the plants along this stretch of the Ohio.",
    photo: { src: virginiaLiving, alt: "Virginia Cottage room with red walls, a white painted-brick fireplace and built-in shelving" },
    homes: ["virginia", "henrietta"].map(home),
  },
];

const audiences = [
  {
    eyebrow: "Travel nurses and residents",
    title: "Sleep close to the unit.",
    body: "Quiet bedrooms for day sleep, a kitchen for long shifts, and the drive to the hospital measured before you sign.",
    href: "/travel-nurses/",
    link: "Travel nurse housing and the stipend guide",
  },
  {
    eyebrow: "Crews and project teams",
    title: "Room for the whole crew.",
    body: "Three-bedroom homes in Marietta, Ohio and Parkersburg, WV, each with a full kitchen and room to spread out, for a month or more on a job.",
    href: "/corporate-housing/",
    link: "Corporate and crew housing",
  },
  {
    eyebrow: "Insurance and relocating families",
    title: "Keep the household together.",
    body: "A whole furnished house while yours is repaired or while you learn a new town, with room for meals, homework and rest.",
    href: "/insurance-housing/",
    link: "Temporary housing after a loss",
  },
  {
    eyebrow: "Long-term stays",
    title: "Settle in without buying furniture.",
    body: "Six months, a year, or the season in between: a move-in-ready home and one predictable monthly guide price.",
    href: "/living.html",
    link: "Furnished living for longer stays",
  },
];

// The drive from each home to its nearest hospital, from the same measured data as the
// location pages (_data/distances.json, #25: OSRM over OpenStreetMap, ODbL). Only homes
// with an approved street address are charted: Buck and Virginia are measured from their
// town centre, which is not the drive a guest would make.
const drives = microsites
  .filter(hasStreetAddress)
  .map((microsite) => {
    const nearest = distancesFor(microsite).groups.find((group) => group.category === "hospital")?.rows[0];
    if (!nearest) throw new Error(`_data/distances.json has no hospital drive for ${microsite.id}`);
    return {
      home: microsite.name,
      href: `/${microsite.town.slug}/${microsite.slug}/location.html#drive-times`,
      to: nearest.name,
      minutes: nearest.minutes,
      miles: nearest.miles,
      measured: nearest.measured,
    };
  })
  .sort((a, b) => a.minutes - b.minutes || a.home.localeCompare(b.home));
if (drives.length === 0) throw new Error("No home with an approved address has a measured hospital drive");
// The axis runs past the longest drive so the value label always fits beside its bar.
const driveScale = Math.max(25, Math.ceil((Math.max(...drives.map((drive) => drive.minutes)) + 9) / 5) * 5);
const driveTicks = Array.from({ length: driveScale / 5 + 1 }, (_, index) => index * 5);
const driveMeasured = [...new Set(drives.map((drive) => drive.measured))].sort();
const measuredMonth = new Date(`${driveMeasured.at(-1)}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const homeCount = towns.reduce((total, town) => total + town.homes.length, 0);
---

<SiteLayout title="Furnished Homes in Marietta & Parkersburg | Mt Cottages" description="Whole furnished houses in Marietta, Ohio, Parkersburg and Ravenswood, WV for stays of a month or more, with a kitchen, laundry and fiber internet.">
  <section class="hero hero--promise" aria-labelledby="promise">
    <div class="site-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Mt Cottages · Furnished homes for a month or longer</p>
        <h1 id="promise">A real home in the river towns, ready the day you arrive.</h1>
        <ul class="hero-towns" aria-label="Towns with Mt Cottages homes">
          {towns.map((town) => <li><a href={town.guide}>{town.short}</a></li>)}
        </ul>
        <CheckDates placement="hero" secondary={{ label: `See the ${homeCount} homes`, href: "#towns" }} />
        <p class="lede mt-3">Whole furnished houses with a kitchen, laundry and fiber internet, for travel nurses, crews, families between homes and anyone staying a while.</p>
      </div>
      <figure class="hero-media"><a class="hero-media__link" href="/marietta/frederick/index.html" aria-label="Explore Frederick Cottage in Marietta, Ohio"><ResponsivePhoto src={homeHero} alt="Frederick Cottage exterior framed by mature trees and a covered entry" priority sizes="(max-width: 900px) 100vw, 56vw" /></a><figcaption>Frederick Cottage · Marietta, Ohio <span aria-hidden="true">↗</span></figcaption></figure>
    </div>
  </section>

  <section class="section section--paper" id="who" aria-labelledby="who-heading">
    <div class="site-width">
      <div class="section-heading"><div><p class="eyebrow">Who stays with us</p><h2 id="who-heading">Start with why you are here.</h2></div><p>People come to the Mid-Ohio Valley to work, heal, relocate or rebuild. Pick the reason closest to yours and we will show you the homes and details that matter for it.</p></div>
      <ul class="audience-grid" data-audience-router>
        {audiences.map((audience) => (
          <li class="audience-card">
            <p class="eyebrow">{audience.eyebrow}</p>
            <h3>{audience.title}</h3>
            <p>{audience.body}</p>
            <a class="text-link" href={audience.href}>{audience.link} <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="towns" aria-labelledby="towns-heading">
    <div class="site-width">
      <div class="section-heading"><div><p class="eyebrow">Three river towns · {homeCount} homes</p><h2 id="towns-heading">Pick the town, then the house.</h2></div><p>Every home below has its own site with a room-by-room photo tour, a plan, the amenities and what is nearby. Monthly guide prices start at {publishedLuxuryFurnishedRates["1 Bedroom"].replace("/month", "")} for one bedroom.</p></div>
      <div class="town-grid" data-town-cards>
        {towns.map((town) => (
          <article class="town-card" id={`town-${town.id}`} aria-labelledby={`town-${town.id}-name`}>
            <figure><ResponsivePhoto src={town.photo.src} alt={town.photo.alt} widths={[360, 640, 900]} sizes="(max-width: 900px) 100vw, 33vw" /></figure>
            <div class="town-card__body">
              <h3 id={`town-${town.id}-name`}>{town.name}</h3>
              <p>{town.note}</p>
              <ul class="town-card__homes" aria-label={`Homes in ${town.short}`}>
                {town.homes.map((cottage) => (
                  <li><a href={`/${cottage.path}`}><strong>{cottage.name}</strong><span>{cottage.bedrooms} · {cottage.price}</span></a></li>
                ))}
              </ul>
              <a class="text-link" href={town.guide}>{town.id === "marietta" ? "Living in Marietta, Ohio" : `Living in ${town.short.replace(", WV", "")}`} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper" id="whole-home" aria-labelledby="whole-home-heading">
    <div class="site-width pillar">
      <div class="pillar__copy">
        <p class="eyebrow">Whole home, nothing to add</p>
        <h2 id="whole-home-heading">Bring your suitcase. The house has the rest.</h2>
        <p class="lede mt-2">A hotel gives you a room. A Mt Cottages home gives you the kitchen, the laundry, a bedroom for everyone and a table to sit at, in one monthly guide price.</p>
        <ul class="checklist mt-3">
          <li><span>Furnished bedrooms, living room and dining space</span></li>
          <li><span>A full kitchen for real meals after a long shift</span></li>
          <li><span>Laundry at the house, so a week of scrubs or work clothes is never a trip out</span></li>
          <li><span>Fiber-optic internet for work and calls home</span></li>
          <li><span>Monthly guide: {publishedLuxuryFurnishedRates["1 Bedroom"]} for one bedroom, {publishedLuxuryFurnishedRates["2 Bedrooms"]} for two, {publishedLuxuryFurnishedRates["3 Bedrooms"]} for three</span></li>
        </ul>
        <p class="details-note mt-2">Utilities, linens and what each home supplies are confirmed on inquiry, home by home.</p>
      </div>
      <div class="pillar__photos">
        <figure><ResponsivePhoto src={frederickKitchen} alt="Frederick Cottage kitchen with oak cabinets and full-size appliances" widths={[360, 640, 900]} sizes="(max-width: 900px) 100vw, 30vw" /><figcaption>Kitchen · Frederick Cottage</figcaption></figure>
        <figure><ResponsivePhoto src={oakBedroom} alt="Oak Cottage guest bedroom with an upholstered headboard" widths={[360, 640]} sizes="(max-width: 900px) 50vw, 20vw" /><figcaption>Bedroom · Oak Cottage</figcaption></figure>
        <figure><ResponsivePhoto src={henriettaLaundry} alt="Henrietta Cottage utility corner with a white top-loading washing machine beneath a window" widths={[360, 640]} sizes="(max-width: 900px) 50vw, 20vw" /><figcaption>Laundry · Henrietta Cottage</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section" id="minutes" aria-labelledby="minutes-heading">
    <div class="site-width">
      <div class="section-heading"><div><p class="eyebrow">Minutes, not miles</p><h2 id="minutes-heading">Close to the hospital that brought you here.</h2></div><p>We describe every home by the drive to the places you need to be. Here is the drive from each home to the nearest hospital’s main campus.</p></div>
      <figure class="drive-chart">
        <table data-drive-chart>
          <caption class="drive-chart__title">Estimated drive from each home to the nearest hospital, in minutes</caption>
          <thead><tr><th scope="col">Home</th><th scope="col">Hospital</th><th scope="col"><span class="sr-only">Drive time</span><span class="drive-chart__axis" aria-hidden="true">{driveTicks.map((tick) => <span style={`--at:${(tick / driveScale) * 100}%`}>{tick}</span>)}</span></th><th scope="col">Distance</th></tr></thead>
          <tbody>
            {drives.map((drive) => (
              <tr>
                <th scope="row"><a href={drive.href}>{drive.home}</a></th>
                <td>{drive.to}</td>
                <td class="drive-chart__bar-cell"><span class="drive-chart__track" style={`--share:${(drive.minutes / driveScale) * 100}%`}><span class="drive-chart__bar" title={`${drive.home} to ${drive.to}: about ${drive.minutes} minutes, ${drive.miles} miles`}></span><span class="drive-chart__value">about {drive.minutes} min</span></span></td>
                <td class="drive-chart__miles">{drive.miles} mi</td>
              </tr>
            ))}
          </tbody>
        </table>
        <figcaption class="details-note">Estimated drive by car from the home to the hospital’s main campus, routed on OpenStreetMap data (© OpenStreetMap contributors, ODbL), measured {measuredMonth}. Traffic, shift-change hours and your unit’s entrance change the time; confirm on inquiry. Buck and Virginia Cottage list drives from their town centre on their own pages; the drive from the house itself is given on inquiry.</figcaption>
      </figure>
      <CheckDates class="mt-3" placement="minutes" secondary={{ label: "Housing for healthcare staff", href: "/travel-nurses/" }} />
    </div>
  </section>
</SiteLayout>
