---
import { Image } from "astro:assets";
import PropertyCard from "../components/PropertyCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { properties } from "../data/properties";
import { getMedia } from "../data/media";

const featured = properties.find((property) => property.id === "marietta-01") ?? properties[0];
const hero = getMedia(featured.id)[0];
---

<BaseLayout title="Furnished homes with room to live" description="Thoughtfully furnished monthly cottages in Marietta, Parkersburg, and Ravenswood." socialImage={hero?.src}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Furnished monthly homes · Ohio & West Virginia</p>
        <h1>A place that feels like yours.</h1>
        <p class="lede">Cottages with the comfort, character, and breathing room to make a new season feel a little more like home.</p>
        <a class="button" href="/cottages.html">Explore the cottages <span aria-hidden="true">↗</span></a>
      </div>
      {hero && <a class="hero-image" href={`/${featured.route}`}><Image src={hero.src} alt={hero.alt} widths={[900, 1400, 1800]} sizes="(min-width: 900px) 60vw, 100vw" quality={86} priority /></a>}
    </div>
  </section>

  <section class="section section-tone">
    <div class="shell">
      <div class="section-heading"><p class="eyebrow">Find your fit</p><h2>Not just a room. A real place to land.</h2><p>Whether work brought you here, family needs more space, or you are simply ready for a change of scene, our furnished homes are set up for the way life actually happens.</p></div>
      <div class="property-grid">
        {properties.slice(0, 5).map((property, index) => <PropertyCard property={property} featured={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="shell split-callout">
    <div><p class="eyebrow">Made for real life</p><h2>Arrive with a suitcase. Stay for a while.</h2></div>
    <div><p>Every M&T cottage comes furnished with the essentials already in place — from cookware and linens to internet, laundry, and utilities. You get the ease of a short stay with the feeling of a home base.</p><a class="text-link" href="/room-to-settle.html">See how it works <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="inquiry-band"><div class="shell inquiry-inner"><div><p class="eyebrow">Your next chapter</p><h2>Let’s make room for it.</h2></div><a class="button button-light" href="/apply.html">Start your application <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
