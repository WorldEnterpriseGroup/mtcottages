---
import SiteLayout from "../layouts/SiteLayout.astro";
import ResponsivePhoto from "../components/ResponsivePhoto.astro";
import PropertyCard from "../components/PropertyCard.astro";
import TrustStrip from "../components/TrustStrip.astro";
import PortfolioCompare from "../components/PortfolioCompare.astro";
import DrillRail from "../components/DrillRail.astro";
import ScrollDepth from "../components/ScrollDepth.astro";
import { cottages } from "../data/site";
import homeHero from "../../assets/images/cottages/parkersburg-02/homepage-hero-buck.avif";
import homeDetail from "../../assets/images/cottages/marietta-01/photo-27.avif";
---

<SiteLayout title="Mt Cottages | Furnished Living" description="Whole furnished homes across the Mid-Ohio Valley for work, transition, family, and longer stays.">
  <section class="hero">
    <div class="site-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Furnished living in the Mid-Ohio Valley</p>
        <h1>Furnished cottages for stays of 30 days or longer.</h1>
        <p class="lede">Compare eight one-, two-, and three-bedroom homes in Marietta, Parkersburg, and Ravenswood. Tell us your dates to confirm current availability and pricing.</p>
        <div class="cluster"><a class="button" href="/cottages.html">Browse 8 cottages <span aria-hidden="true">↗</span></a><a class="text-link" href="/apply.html">Ask about your dates <span aria-hidden="true">↗</span></a></div>
        <p class="kicker mt-4">Marietta · Parkersburg · Ravenswood · Racine</p>
      </div>
      <figure class="hero-media hero-stack"><span class="hero-badge">Level 1 · Start here</span><ResponsivePhoto src={homeHero} alt="Buck Cottage front exterior with porch, centered entry, and mature trees" priority sizes="(max-width: 900px) 100vw, 60vw" /><figcaption>Homes with room for the season ahead.</figcaption></figure>
    </div>
  </section>

  <TrustStrip />

  <section class="section section--paper">
    <div class="site-width">
      <div class="section-heading"><div><p class="eyebrow">Room to settle in</p><h2>Choose the shape of the stay.</h2></div><p>A real kitchen, separate bedrooms, laundry, and somewhere to exhale can change the rhythm of an extended stay. Start with the reason you are here, then compare the home and community around it.</p></div>
      <div class="story-grid"><article class="story-card"><p class="eyebrow">01 · Browse</p><h3>Find a home by size, town, and timing.</h3><p>See the public cottages and use each photo story to understand what the home makes visible.</p><a class="text-link" href="/cottages.html">Browse cottages <span aria-hidden="true">↗</span></a></article><article class="story-card story-card--dark"><p class="eyebrow">02 · Plan</p><h3>Start with the life around the stay.</h3><p>Healthcare, work, relocation, insurance, and family stays each ask different questions.</p><a class="text-link" style="color:#e4b482" href="/living.html">Explore living guides <span aria-hidden="true">↗</span></a></article></div>
    </div>
  </section>

  <section class="section">
    <div class="site-width"><div class="section-heading"><div><p class="eyebrow">Homes currently listed</p><h2>Start with the homes.</h2></div><p>Compare the community, bedroom count, monthly guide, and photographs that matter to your everyday stay.</p></div><div class="card-grid card-grid--four">{cottages.slice(0, 4).map((cottage) => <PropertyCard cottage={cottage} />)}</div><a class="text-link mt-3" href="/cottages.html">See all listed cottages <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="section section--paper" aria-labelledby="drill-frederick">
    <div class="site-width">
      <div class="section-heading reveal"><div><p class="eyebrow">Drill down · Level 1 → 3</p><h2 id="drill-frederick" class="balance">From the Valley to Frederick’s rooms.</h2></div><p>Not a flat list. Pick Marietta, open Frederick Cottage, then drop into bedrooms, kitchen, outdoors, and the searchable Nearby guide.</p></div>
      <div class="drill-bento stagger">
        <article class="bento-card bento-card--dark reveal"><p class="eyebrow" style="color:#e4b482">Level 2 · Featured microsite</p><h3>Frederick Cottage in Marietta</h3><p>Three bedrooms, working kitchen, gathering rooms, fenced yard — each space is its own page with real photos.</p><div class="cluster"><a class="button button--light" href="/marietta/frederick/index.html">Open the microsite</a><a class="text-link" style="color:#fff" href="/marietta/index.html">Level 1 · Marietta guide</a></div></article>
        <article class="bento-card reveal"><p class="eyebrow">Level 3 · Sleep</p><h3>Bedrooms as destinations</h3><p>King, double, and queen rooms with daylight, storage, and work corners.</p><a class="text-link" href="/marietta/frederick/rooms.html">Drill into bedrooms ↗</a></article>
        <article class="bento-card reveal"><p class="eyebrow">Level 3 · Nearby</p><h3>Trails, food, parks, essentials</h3><p>Searchable guide with new trail and restaurant photos, Buckeye Park, shopping, and hospitals.</p><a class="text-link" href="/marietta/frederick/area.html">Drill into Nearby ↗</a></article>
      </div>
      <div class="mt-3 reveal">
        <DrillRail
          up={{ eyebrow: "Level 1 · Up", label: "Marietta guide", href: "/marietta/index.html", description: "Town context before the house." }}
          prev={{ eyebrow: "Level 3 · Sideways", label: "Kitchen + living", href: "/marietta/frederick/kitchen.html", description: "Cook and gather one level deeper." }}
          next={{ eyebrow: "Level 3 · Deepest", label: "Gallery + arrival", href: "/marietta/frederick/gallery.html", description: "Every photo, then how to arrive." }}
        />
      </div>
    </div>
  </section>
  <ScrollDepth />

  <PortfolioCompare cottages={cottages} />

  <section class="section section--dark"><div class="site-width split"><div><p class="eyebrow" style="color:#e4b482">What stays with you</p><h2>Care that makes furnished living feel easier.</h2></div><div class="stack"><p class="lede lede--light">We think about the practical parts around the room: timing, routes, household, upkeep, and the details that make a place feel ready.</p><div class="cluster"><a class="button button--light" href="/services.html">Explore services</a><a class="text-link" style="color:#e4b482" href="/contact.html">Talk with Mt Cottages <span aria-hidden="true">↗</span></a></div></div></div></section>

  <section class="section section--paper"><div class="site-width split split--wide"><figure class="hero-image-frame"><ResponsivePhoto src={homeDetail} alt="Frederick Cottage dining and entry area with table, staircase, and natural light" sizes="(max-width: 900px) 100vw, 55vw" /><figcaption class="sr-only">A furnished home is made of useful details.</figcaption></figure><div class="align-end"><p class="eyebrow">The details matter</p><h2>More than a room. A working home.</h2><p class="lede mt-2">See kitchens, bedrooms, living spaces, outdoor areas, and the practical features that help a longer stay function.</p><a class="button mt-3" href="/home-amenities.html">See what is included <span aria-hidden="true">↗</span></a></div></div></section>
</SiteLayout>
