---
import SiteLayout from "../layouts/SiteLayout.astro";
import ResponsivePhoto from "../components/ResponsivePhoto.astro";
import PropertyCard from "../components/PropertyCard.astro";
import DetailsPanel from "../components/DetailsPanel.astro";
import PropertyGallery from "../components/PropertyGallery.astro";
import GuidePage from "../components/GuidePage.astro";
import { cottages, cottageByPath, guides, locationData, navGroups, routePaths, type Cottage, type Guide } from "../data/site";

export function getStaticPaths() {
  return routePaths.map((path) => ({ params: { slug: path.replace(/\.html$/, "") } }));
}

const routePath = Astro.url.pathname.replace(/^\/+/, "") || "index.html";
const cottage = cottageByPath.get(routePath);
const guideKey = Object.keys(guides).find((key) => guides[key].path === routePath);
const locationKey = Object.keys(locationData).find((key) => locationData[key].path === routePath);
const title = cottage ? `${cottage.name} | Furnished Stay in ${cottage.town}` : guideKey ? `${guides[guideKey].title} | Mt Cottages` : locationKey ? `${locationData[locationKey].town} Furnished Living | Mt Cottages` : routePath.replace(/\.html$/, "").replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase()) + " | Mt Cottages";
const description = cottage?.summary || (guideKey ? guides[guideKey].description : locationKey ? locationData[locationKey].description : "Furnished living and practical support across the Mid-Ohio Valley.");

const utility: Record<string, { eyebrow: string; title: string; description: string; sections: { title: string; body: string }[]; cta?: string }> = {
  "about.html": { eyebrow: "About Mt Cottages", title: "Hospitality with a little more room to breathe.", description: "Furnished living that feels personal for the work and life ahead.", sections: [{ title: "A home that fits the chapter", body: "Mt Cottages offers furnished homes across the Mid-Ohio Valley for guests navigating work, care, relocation, repairs, family, and the transitions that take more than a few nights." }, { title: "Practical by design", body: "We pay attention to the details around the stay: timing, community, furnishings, communication, and the care that helps a place feel ready." }, { title: "A clear next step", body: "Tell us what you need and we will compare your timing and household with current public options." }], cta: "Start a stay inquiry" },
  "services.html": { eyebrow: "Services", title: "Care that makes furnished living feel easier.", description: "Explore the practical support around a Mt Cottages stay.", sections: [{ title: "Homes prepared for longer stays", body: "Furnished rooms, kitchens, living space, laundry, and the details that let ordinary life continue." }, { title: "Support around the home", body: "Guest services, property care, housekeeping, meal preparation, and clear paths for current residents." }, { title: "A stay shaped around the reason", body: "Start with the timing, community, household, and details that matter to your situation." }], cta: "Plan a stay" },
  "available.html": { eyebrow: "Available now", title: "Keep options open.", description: "Availability changes by home, timing, and stay shape. Start with the current public portfolio, then ask about the dates that matter to you.", sections: [{ title: "A useful starting point", body: "Review the homes and communities first. The public site shows the properties with the clearest current photo stories." }, { title: "Current availability needs confirmation", body: "Prices, dates, and stay requirements can change. We confirm the actual next step after learning more about the household and timing." }], cta: "Ask about availability" },
  "contact.html": { eyebrow: "Contact", title: "Start with a useful conversation.", description: "Tell us where you need to be, how long you may stay, and what would make a furnished place work.", sections: [{ title: "Email Mt Cottages", body: "For general questions, email stay@mtcottages.com. For a stay inquiry, use the application path so we can capture timing and household details together." }, { title: "Serving the Valley", body: "Marietta · Parkersburg · Ravenswood · Racine. We can also discuss current options in nearby communities when the fit is right." }], cta: "Start a stay inquiry" },
  "faq.html": { eyebrow: "Common questions", title: "Furnished living, answered.", description: "A few practical answers before you choose a place.", sections: [{ title: "How long can I stay?", body: "Mt Cottages is built around furnished stays of 30 days or longer. Ask about the current home and timing." }, { title: "What should I share first?", body: "Dates, preferred community, household, reason for staying, bedroom needs, pets, and any accessibility or furnishing questions." }, { title: "Is an inquiry a lease or approval?", body: "No. A site inquiry is a conversation about current options. Any later screening, agreement, or approval is a separate step." }], cta: "Ask a question" },
  "fully-furnished-homes.html": { eyebrow: "Services · Homes", title: "A real home, prepared for the way extended stays work.", description: "A furnished home gives the stay a kitchen, bedrooms, laundry, and a place to breathe.", sections: [{ title: "The useful baseline", body: "Furnishings, kitchen equipment, living space, bedrooms, and the practical details that support a longer stay." }, { title: "The fit is specific", body: "Homes vary. Tell us your household, timing, and daily needs so we can point you to the right details." }], cta: "Explore cottages" },
  "home-amenities.html": { eyebrow: "Services · Home amenities", title: "The everyday features that help a longer stay function.", description: "See the practical baseline behind a furnished home.", sections: [{ title: "A place to cook", body: "Full kitchens give guests a way to keep everyday routines going beyond a hotel meal or takeout order." }, { title: "A place to reset", body: "Living rooms, private bedrooms, laundry, storage, and guest support all contribute to a workable stay." }], cta: "See public homes" },
  "guest-services.html": { eyebrow: "Services · Guest services", title: "A direct point of contact before and during your stay.", description: "The small details around a furnished stay should not require guesswork.", sections: [{ title: "Start with clarity", body: "Share the dates, household, community, and questions that matter. We will explain what is known and what needs confirmation." }, { title: "Support continues after arrival", body: "Current guests have a clear path for home questions, maintenance, and urgent situations." }], cta: "Talk with Mt Cottages" },
  "property-care.html": { eyebrow: "Services · Property care", title: "Care for the home supports a more comfortable stay.", description: "The guest experience depends on the condition and readiness of the home.", sections: [{ title: "A ready home is an ongoing practice", body: "Property care keeps the practical details visible so guests can focus on the reason they came." }, { title: "Report what needs attention", body: "Current residents should use the maintenance path for non-emergency requests and the emergency guidance when there is immediate danger." }], cta: "See resident support" },
  "housekeeping.html": { eyebrow: "Services · Housekeeping", title: "Housekeeping that can be shaped around an extended stay.", description: "Ask about the housekeeping options and timing available for the home you are considering.", sections: [{ title: "A cleaner rhythm", body: "An extended stay works better when the practical upkeep has a clear plan." }, { title: "Confirm what is available", body: "Services vary by home and arrangement. Tell us your timing and what kind of support would help." }], cta: "Ask about services" },
  "meal-preparation.html": { eyebrow: "Services · Meal preparation", title: "An extra layer of help with meals.", description: "Ask about optional meal preparation for a furnished stay.", sections: [{ title: "Keep the stay workable", body: "Meals are part of the daily rhythm. Discuss timing, household needs, and what support is available." }, { title: "Home first", body: "Every service should make the furnished home easier to use rather than make the arrangement more complicated." }], cta: "Ask about meal preparation" },
  "partnerships.html": { eyebrow: "Partnerships", title: "Care that makes furnished living feel easy.", description: "Mt Cottages can support partner-led housing for visiting scientists, researchers, healthcare professionals, relocating teams, and other extended-stay needs.", sections: [{ title: "Partner-led housing", body: "Discuss timing, household information, furnishing needs, and the communication path that will make a placement workable." }, { title: "A distinct public audience", body: "Mt Cottages serves guests and residents. Operational property information stays private and is handled through the appropriate partner conversation." }], cta: "Discuss a partnership" },
  "residents.html": { eyebrow: "Residents", title: "Support for the stay you are in.", description: "Current residents have a simple path for access, payments, maintenance, and home support.", sections: [{ title: "Resident portal", body: "Use the resident portal when your arrangement provides access there." }, { title: "Payments", body: "Use the instructions tied to your current agreement. Never email card numbers, bank credentials, or sensitive identity information." }, { title: "Home support", body: "Use maintenance requests for non-emergency issues and emergency guidance when there is immediate danger." }], cta: "Open resident resources" },
  "resident-portal.html": { eyebrow: "Resident support", title: "A secure path for current residents.", description: "Use the portal link and instructions provided for your current home arrangement.", sections: [{ title: "Current resident access", body: "Portal access is provided directly to current residents. If you need the correct link, contact stay@mtcottages.com from the email associated with your stay." }], cta: "Contact resident support" },
  "pay-rent.html": { eyebrow: "Resident support", title: "Keep payment details secure.", description: "Use the secure payment instructions provided for your agreement.", sections: [{ title: "Use the right instructions", body: "Payment methods can vary by home and arrangement. Contact Mt Cottages if you need the correct link or instructions." }, { title: "Keep information private", body: "Never send card numbers, bank credentials, or sensitive identity information through ordinary email." }], cta: "Ask for payment support" },
  "maintenance.html": { eyebrow: "Resident support", title: "Submit a clear maintenance request.", description: "A useful request includes the home, location, problem, timing, and photos only when they help explain the issue without exposing private information.", sections: [{ title: "What to include", body: "Describe what happened, where it is, when it started, and whether the issue is affecting safety or ordinary use." }, { title: "When it is urgent", body: "If there is immediate danger, call 911 or the appropriate emergency service first, then use the resident support channel provided for your home." }], cta: "Email maintenance" },
  "emergency-maintenance.html": { eyebrow: "Resident support", title: "Emergency maintenance guidance.", description: "If there is fire, an active gas smell, flooding that will cause immediate damage, or another immediate danger, call 911 or the appropriate emergency service first.", sections: [{ title: "Then contact resident support", body: "After immediate safety is handled, contact the resident support channel provided for your home and explain what happened." }, { title: "Do not email sensitive information", body: "Do not send payment-card numbers, bank credentials, Social Security numbers, or other highly sensitive information by ordinary email." }], cta: "Contact resident support" },
};

const utilityPage = utility[routePath];
const pageGuide: Guide | undefined = guideKey ? guides[guideKey] : undefined;
const pageLocation = locationKey ? locationData[locationKey] : undefined;
---

<SiteLayout title={title} description={description}>
  {cottage ? (
    <>
      <section class="property-hero section--tight">
        <div class="site-width property-hero-grid">
          <div><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${cottage.locationPath}`}>{cottage.town}</a><span aria-hidden="true">/</span><span>{cottage.name}</span></nav><p class="eyebrow mt-3">{cottage.town}</p><h1>{cottage.name}</h1><p class="lede">{cottage.summary}</p></div>
          <figure class="hero-image-frame"><ResponsivePhoto {...cottage.hero} priority sizes="(max-width: 900px) 100vw, 62vw" /><figcaption class="sr-only">{cottage.hero.alt}</figcaption></figure>
        </div>
      </section>
      <section class="section section--paper"><div class="site-width split split--wide"><div class="stack"><p class="eyebrow">Why this home may fit</p><h2>See the useful details quickly.</h2><p class="lede">{cottage.summary}</p><p class="text-muted">The photo story below is intentionally ordered around the way a guest evaluates a longer stay: arrival, kitchen, living space, bedrooms, bath, and the details that make the home personal.</p></div><DetailsPanel cottage={cottage} /></div></section>
      <section class="section"><div class="site-width"><div class="section-heading"><div><p class="eyebrow">Included in the story</p><h2>Amenity cards, not a wall of checkmarks.</h2></div><p>These are the practical elements that help a furnished home function. Confirm home-specific details during the inquiry.</p></div><div class="amenity-grid">{cottage.amenities.map((amenity, index) => <div class="amenity"><span aria-hidden="true">{["⌂", "＋", "◌", "▦", "◇", "↗"][index % 6]}</span><span>{amenity}</span></div>)}</div></div></section>
      <PropertyGallery cottage={cottage} />
      <section class="section section--dark"><div class="site-width split"><div><p class="eyebrow" style="color:#e4b482">Ready to compare</p><h2>Ask about {cottage.name}.</h2></div><div><p class="lede lede--light">Tell us your timing, household, and what you need from a place. We will confirm availability, pricing, and the right next step.</p><a class="button button--light mt-3" href="https://stay.mtcottages.com/">Start a stay inquiry <span aria-hidden="true">↗</span></a></div></div></section>
    </>
  ) : pageGuide ? (
    <GuidePage guide={pageGuide} cottages={cottages.filter((item) => pageGuide.path === "living.html" ? ["frederick", "broad", "buck"].includes(item.id) : pageGuide.path === "family-stays.html" ? ["oak", "white", "henrietta"].includes(item.id) : [])} />
  ) : pageLocation ? (
    <GuidePage guide={pageLocation} cottages={pageLocation.cottages} />
  ) : utilityPage ? (
    <GuidePage guide={{ ...utilityPage, path: routePath, sections: utilityPage.sections }} cottages={routePath === "cottages.html" ? cottages : []} />
  ) : routePath === "cottages.html" || routePath === "cozy-places.html" || routePath === "room-to-settle.html" ? (
    <section class="section"><div class="site-width"><p class="eyebrow">Cottages</p><h1>{routePath === "cozy-places.html" ? "Cozy places." : routePath === "room-to-settle.html" ? "Room to settle in." : "Browse our furnished homes."}</h1><p class="lede mt-2">Compare the public homes by town, bedroom count, price, and the photo story that helps you see the fit.</p><div class="card-grid mt-4">{(routePath === "cozy-places.html" ? cottages.filter((item) => item.bedrooms === "1 Bedroom") : routePath === "room-to-settle.html" ? cottages.filter((item) => item.bedrooms !== "1 Bedroom") : cottages).map((item) => <PropertyCard cottage={item} />)}</div></div></section>
  ) : (
    <GuidePage guide={{ path: routePath, eyebrow: "Mt Cottages", title: title.replace(" | Mt Cottages", ""), description, intro: "Explore the public homes, location guides, and practical support around a furnished stay.", sections: [{ title: "Start with the main paths", body: "Browse cottages, compare locations, explore living guides, or start a direct conversation about your timing and household." }] }} />
  )}
</SiteLayout>
