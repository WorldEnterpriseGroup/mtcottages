---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getMedia } from "../data/media";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  heading: string;
  copy: string;
  propertyId?: string;
}

const { title, description, heading, copy, propertyId = "marietta-01" } = Astro.props;
const photos = getMedia(propertyId).slice(0, 3);
---

<BaseLayout title={title} description={description} socialImage={photos[0]?.src}>
  <section class="utility-page shell"><div><p class="eyebrow">M&T Cottages</p><h1>{heading}</h1><p class="lede">{copy}</p><a class="button" href="/cottages.html">Explore the cottages <span aria-hidden="true">↗</span></a></div></section>
  <section class="section section-tone"><div class="shell editorial-grid">{photos.map((photo) => <figure><Image src={photo.src} alt={photo.alt} widths={[560, 900]} sizes="(min-width: 900px) 33vw, 92vw" quality={80} loading="lazy" /><figcaption>{photo.room}</figcaption></figure>)}</div></section>
</BaseLayout>
