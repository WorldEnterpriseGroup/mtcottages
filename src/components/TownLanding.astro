---
/**
 * Town landing page (#24 Parkersburg, #28 Marietta): who the homes suit, the
 * live homes with a CTA each, measured drive times, what is included and what
 * is confirmed on inquiry, and an FAQ whose words match its FAQPage schema.
 * Data and honesty rules: src/data/townLanding.ts.
 */
import "../styles/town-landing.css";
import ResponsivePhoto from "./ResponsivePhoto.astro";
import { confirmedPriceHomes, landingHome, type TownLanding, type RouteTime } from "../data/townLanding";
import { homeHref } from "../data/homes/links";
import { stayLink } from "../data/stay-link";
import { monthlyRateText } from "../data/terms";
import type { Crumb } from "../data/schema";
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
  landing: TownLanding;
  crumbs: Crumb[];
}

const { landing, crumbs } = Astro.props;
// Every inquiry link carries its source page (#20): the town CTAs pre-select the
// town, and each home's "Ask about" link pre-selects that home instead.
const page = Astro.url.pathname;
const townInquiryHref = stayLink({ home: landing.stayHome, town: landing.stayTown, page });
const homeInquiryHref = (id: string) => stayLink({ home: id, page });
const homes = landing.homes.map((entry) => ({ ...entry, home: landingHome(entry.id) }));
const rowName = (id: string) => landingHome(id).name;
const formatTime = (time: RouteTime) => `${time.minutes} min`;
const formatMiles = (time: RouteTime) => `${time.miles.toFixed(1)} mi`;
// Sections alternate paper and canvas; the optional story section shifts the rhythm by one.
const shifted = Boolean(landing.story);
---

<section class="guide-hero section--tight tl-hero">
  <div class="site-width guide-hero-grid">
    <div>
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow mt-3">{landing.eyebrow}</p>
      <h1>{landing.h1}</h1>
      <p class="lede" data-testid="town-lede">{landing.lede}</p>
      <p class="mt-2 reading">{landing.intro}</p>
      <div class="cluster mt-3">
        <a class="button" href={townInquiryHref}>{landing.inquiryLabel} <span aria-hidden="true">↗</span></a>
        <a class="button button--ghost" href="#homes">See the homes</a>
      </div>
    </div>
    <figure class="hero-image-frame">
      <ResponsivePhoto {...landing.hero} priority sizes="(max-width: 900px) 100vw, 55vw" />
    </figure>
  </div>
</section>

<section class="section section--paper" id="homes" aria-labelledby="tl-homes-title">
  <div class="site-width">
    <div class="section-heading">
      <div><p class="eyebrow">Live homes</p><h2 id="tl-homes-title">{landing.homesHeading}</h2></div>
      <p>{landing.homesIntro}</p>
    </div>
    <ul class:list={["card-grid tl-homes", { "tl-homes--single": homes.length === 1 }]} role="list">
      {homes.map(({ home, fit, facts }) => (
        <li class="property-card tl-home" data-home={home.id}>
          <a href={homeHref(home)} tabindex="-1" aria-hidden="true">
            <figure><ResponsivePhoto {...home.hero} widths={[360, 640, 900]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw" /></figure>
          </a>
          <div class="property-card-body">
            <div>
              <h3><a href={homeHref(home)}>{home.name}</a></h3>
              <p class="location">{home.town.name}, {home.town.state}</p>
            </div>
            <p>{fit}</p>
            <ul class="tl-facts">{facts.map((fact) => <li>{fact}</li>)}</ul>
            {confirmedPriceHomes.includes(home.id) && monthlyRateText(home.id)
              ? <p class="tl-price"><span>Monthly guide</span> <strong>{monthlyRateText(home.id)}</strong></p>
              : <p class="tl-price tl-price--confirm">Price: confirm on inquiry</p>}
            <div class="tl-home-actions">
              <a class="property-link" href={homeHref(home)}>Explore {home.name} <span aria-hidden="true">→</span></a>
              <a class="button button--ghost tl-ask" href={homeInquiryHref(home.id)}>Ask about {home.name} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section" id="distances" aria-labelledby="tl-distance-title">
  <div class="site-width">
    <div class="section-heading">
      <div><p class="eyebrow">Getting around</p><h2 id="tl-distance-title">{landing.distance.heading}</h2></div>
      <p>{landing.distance.intro}</p>
    </div>
    <div class="tl-table-scroll" role="region" aria-labelledby="tl-distance-caption" tabindex="0">
      <table class="tl-table">
        <caption id="tl-distance-caption" class="sr-only">{landing.distance.mode === "drive-walk" ? "Driving and walking time" : "Driving time"} and distance from each home</caption>
        <thead>
          <tr><th scope="col">Home</th>{landing.distance.destinations.map((destination) => <th scope="col">{destination}</th>)}</tr>
        </thead>
        <tbody>
          {landing.distance.rows.map((row) => {
            const walk = landing.distance.walkRows?.find((entry) => entry.homeId === row.homeId);
            return (
              <tr>
                <th scope="row">{rowName(row.homeId)}{row.note && row.times.some((time) => time !== null) && <span class="tl-walk">{row.note}</span>}</th>
                {row.times.every((time) => time === null)
                  ? <td colspan={landing.distance.destinations.length}>{row.note}</td>
                  : row.times.map((time, index) => (
                    <td>
                      {time ? <><strong>{formatTime(time)}</strong> <span class="tl-miles">drive, {formatMiles(time)}</span></> : "Confirm on inquiry"}
                      {walk?.times[index] && <span class="tl-walk">{formatTime(walk.times[index] as RouteTime)} walk</span>}
                    </td>
                  ))}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="details-note mt-2">{landing.distance.source}</p>
  </div>
</section>

{landing.story && (
  <section class="section section--paper" id="story" aria-labelledby="tl-story-title">
    <div class="site-width split split--wide">
      <div>
        <p class="eyebrow">{landing.story.eyebrow}</p>
        <h2 id="tl-story-title">{landing.story.heading}</h2>
      </div>
      <div class="stack reading">{landing.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    </div>
  </section>
)}

<section class:list={["section", { "section--paper": !shifted }]} aria-labelledby="tl-included-title">
  <div class="site-width split">
    <div class="stack">
      <p class="eyebrow">In every home</p>
      <h2 id="tl-included-title">What comes with the home</h2>
      <ul class="checklist" role="list">{landing.included.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="stack">
      <p class="eyebrow">Confirm on inquiry</p>
      <h2>What we confirm with you first</h2>
      <p class="text-muted">These differ by home or have not been confirmed for every home yet. We answer each one in writing before you commit, so nothing is a surprise on move-in day.</p>
      <ul class="tl-confirm" role="list">{landing.confirm.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>
</section>

<section class:list={["section", { "section--paper": shifted }]} aria-labelledby="tl-fit-title">
  <div class="site-width">
    <div class="section-heading">
      <div><p class="eyebrow">Who stays with us</p><h2 id="tl-fit-title">Who these homes suit</h2></div>
      <p>Most guests come to {landing.shortTown} for work, care or a change of plans. Pick the path that sounds like yours.</p>
    </div>
    <ul class="tl-audiences" role="list">
      {landing.audiences.map((audience) => (
        <li class="story-card">
          <h3>{audience.title}</h3>
          <p>{audience.body}</p>
          {audience.more && <a class="inline-link" href={audience.more.href}>{audience.more.label} <span aria-hidden="true">→</span></a>}
          <a class="inline-link" href={audience.href}>{audience.linkLabel} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class:list={["section", { "section--paper": !shifted }]} id="faq" aria-labelledby="tl-faq-title">
  <div class="site-width split split--wide">
    <div>
      <p class="eyebrow">Questions</p>
      <h2 id="tl-faq-title">Furnished rentals in {landing.shortTown}, answered</h2>
    </div>
    <div class="faq">
      {landing.faqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section section--dark" aria-labelledby="tl-next-title">
  <div class="site-width split split--wide">
    <div>
      <p class="eyebrow tl-eyebrow-light">The next step</p>
      <h2 id="tl-next-title">Tell us your dates. We will tell you what fits.</h2>
    </div>
    <div>
      <p class="lede lede--light">Share your timing, who is coming and why you are in {landing.shortTown}. We reply with the homes that fit, their current price and what is included. An inquiry is a conversation, not a lease.</p>
      <a class="button button--light mt-3" href={townInquiryHref}>{landing.inquiryLabel} <span aria-hidden="true">↗</span></a>
      <p class="tl-nearby mt-3" data-book-safely>Before you pay anyone, read <a href="/book-safely/">how to book with us safely</a>.</p>
      <p class="tl-nearby mt-3">Also nearby: {landing.nearbyTowns.map((town, index) => <>{index > 0 && " · "}<a href={town.href}>{town.name}</a></>)}</p>
    </div>
  </div>
</section>
