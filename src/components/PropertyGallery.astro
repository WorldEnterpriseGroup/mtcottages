---
import ResponsivePhoto from "./ResponsivePhoto.astro";
import type { Cottage } from "../data/site";
const { cottage } = Astro.props as { cottage: Cottage };
---
<section class="section section--paper" aria-labelledby="gallery-title">
  <div class="site-width">
    <div class="section-heading">
      <div><p class="eyebrow">A deliberate property story</p><h2 id="gallery-title">See how the home lives.</h2></div>
      <p>We are building each gallery around the same useful sequence: arrival, kitchen, living, bedrooms, bath, and the details that help a longer stay make sense.</p>
    </div>
    <div class="gallery-grid">
      {cottage.gallery.map((item) => <figure class="gallery-item"><ResponsivePhoto {...item} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw" /><figcaption>{item.caption || item.alt}</figcaption></figure>)}
    </div>
    <div class="coverage mt-3" aria-label="Photo coverage"><span>Photo coverage</span>{cottage.coverage.map((item) => <span>{item}</span>)}</div>
  </div>
</section>
