---
import type { MicrositeAction, PropertyNavItem } from "./types";
import { micrositeSlug } from "./utils";

interface Props {
  propertyName: string;
  propertyHref?: string;
  items?: PropertyNavItem[];
  inquiry?: MicrositeAction;
  ariaLabel?: string;
}

const {
  propertyName,
  propertyHref,
  items,
  inquiry,
  ariaLabel = "Property sections",
} = Astro.props;

const navItems: PropertyNavItem[] = items?.length
  ? items
  : [
      { label: "Overview", href: "#overview" },
      { label: "Gallery", href: "#gallery" },
      { label: "Amenities", href: "#amenities" },
      { label: "Nearby", href: "#nearby" },
    ];
const navId = `property-subnav-${micrositeSlug(propertyName)}`;
---

<nav class="microsite-property-subnav" id={navId} aria-label={ariaLabel} data-microsite-property-subnav>
  <div class="microsite-property-subnav__inner">
    {propertyHref ? (
      <a class="microsite-property-subnav__property" href={propertyHref}>
        <span class="microsite-property-subnav__back" aria-hidden="true">←</span>
        <span>{propertyName}</span>
      </a>
    ) : (
      <span class="microsite-property-subnav__property">{propertyName}</span>
    )}

    <ul class="microsite-property-subnav__links">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.current ? "location" : undefined}
            data-microsite-property-link
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    {inquiry && (
      <a
        class="microsite-property-subnav__action"
        href={inquiry.href}
        target={inquiry.external ? "_blank" : undefined}
        rel={inquiry.external ? "noopener noreferrer" : undefined}
      >
        {inquiry.label}
        <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</nav>
