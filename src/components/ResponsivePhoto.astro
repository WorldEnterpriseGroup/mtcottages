---
import { Image } from "astro:assets";
import type { Photo } from "../data/site";

interface Props extends Photo {
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  priority?: boolean;
  class?: string;
}

const { src, alt, caption, focal, widths = [640, 960, 1280], sizes = "(max-width: 900px) 100vw, 70vw", loading = "lazy", priority = false, class: className } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="avif"
  loading={priority ? "eager" : loading}
  decoding="async"
  fetchpriority={priority ? "high" : "auto"}
  style={focal ? `object-position:${focal}` : undefined}
  class={className}
  data-caption={caption}
  {...(priority ? { "data-priority": "true" } : {})}
/>
