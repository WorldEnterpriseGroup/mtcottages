---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Property } from "../data/properties";
import { getMedia } from "../data/media";

interface Props {
  property: Property;
}

const { property } = Astro.props;
const photos = getMedia(property.id);
const [lead, ...gallery] = photos;
---

<BaseLayout title={property.name} description={property.summary} socialImage={lead?.src}>
  <div class="property-page">
    <section class="property-hero shell">
      <div class="property-hero-copy">
        <p class="eyebrow">{property.town} · Furnished monthly rental</p>
        <h1>{property.name}</h1>
        <p class="lede">{property.summary}</p>
        <div class="property-facts" aria-label="Property facts">
          <span>{property.bedrooms} {property.bedrooms === 1 ? "bedroom" : "bedrooms"}</span>
          <span>{property.bathrooms} full bath</span>
          <span>Utilities included</span>
        </div>
        <div class="hero-actions">
          <a class="button" href="/apply.html">Ask about this cottage <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/cottages.html">See all cottages</a>
        </div>
      </div>
      {lead && <div class="property-hero-image"><Image src={lead.src} alt={lead.alt} widths={[900, 1400, 1800]} sizes="(min-width: 1100px) 56vw, 100vw" quality={86} priority /></div>}
    </section>

    <section class="gallery-section shell" aria-labelledby="gallery-title">
      <div class="section-heading section-heading-inline">
        <div><p class="eyebrow">A closer look</p><h2 id="gallery-title">Make yourself at home.</h2></div>
        <p>Every room is furnished, cared for, and ready for a longer stay.</p>
      </div>
      <div class="property-gallery">
        {gallery.map((photo, index) => (
          <figure class:list={{ "gallery-feature": index === 0, "gallery-tall": index === 2 }}>
            <Image src={photo.src} alt={photo.alt} widths={[560, 900]} sizes="(min-width: 900px) 33vw, 92vw" quality={82} loading="lazy" />
            <figcaption>{photo.room}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="property-details shell">
      <div class="detail-story"><p class="eyebrow">The feeling of the place</p><h2>Room to arrive, settle in, and stay awhile.</h2><p>{property.description}</p></div>
      <div class="detail-columns">
        <div><p class="footer-label">What is included</p><ul class="check-list">{property.amenities.map((amenity) => <li>{amenity}</li>)}</ul></div>
        <div><p class="footer-label">Around the cottage</p><p>{property.neighborhood}</p><ul class="plain-list">{property.proximity.map((place) => <li>{place}</li>)}</ul></div>
      </div>
    </section>

    <section class="inquiry-band">
      <div class="shell inquiry-inner"><div><p class="eyebrow">Ready when you are</p><h2>Let’s find the right fit.</h2></div><a class="button button-light" href="/apply.html">Start your application <span aria-hidden="true">↗</span></a></div>
    </section>
  </div>
</BaseLayout>
