        <line x1="304" y1="164" x2="314" y2="164" stroke="#2e7fbf" stroke-width="1.5" />
        <text x="318" y="83" class="fp-dim">3′-0″</text>
        <text x="318" y="167" class="fp-dim">3′-0″</text>
