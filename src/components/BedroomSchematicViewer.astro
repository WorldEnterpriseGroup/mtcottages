  </figure>
  </div>

  <div class="schematic-controls">
    <button type="button" class="button" data-load-3d aria-expanded="false" aria-controls={`canvas-${roomId}`}>Open clean 3D — spin + zoom</button>
    <p class="text-muted" data-status role="status">AI illustrative 3D</p>
  </div>

  <p class="ai-concept">AI-assisted illustrative 3D — dollhouse view. Not a photo, not measured. Real bedroom photos are above.</p>

  <div class="schematic-stage" hidden>
    <canvas id={`canvas-${roomId}`} role="img" aria-label={`${roomLabel} clean 3D. Drag to spin, scroll to zoom.`} tabindex="0"></canvas>
    <div class="schematic-hint">Drag to spin · scroll to zoom · arrows rotate · +/− zoom · R resets.</div>
  </div>

  <ul class="checklist schematic-facts">{features.map((f) => <li>{f}</li>)}</ul>
</div>

<script type="module">
  const viewers = document.querySelectorAll("[data-room-viewer]");
  let threePromise = null;
  const loadThree = () => {
    if (!threePromise) threePromise = import("https://unpkg.com/three@0.160.0/build/three.module.js");
    return threePromise;
  };
  const WALL_H = 1.2, WALL_T = 0.14;
  const RX = 2.5, RZ = 2.9; // half extents; room 5.0 x 5.8

  viewers.forEach((root) => {
    const btn = root.querySelector("[data-load-3d]");
    const status = root.querySelector("[data-status]");
    const stage = root.querySelector(".schematic-stage");
    const canvas = root.querySelector("canvas");
    const roomId = root.getAttribute("data-room-viewer");
    const bedW = parseFloat(root.dataset.bedW || "1.8");
    const bedD = parseFloat(root.dataset.bedD || "2.0");
    let renderer = null, scene = null, camera = null, rig = null;
    let theta = roomId === "bedroom-2" ? (3 * Math.PI) / 4 : Math.PI / 4, phi = 0.7, radius = 10.5, dragging = false, px = 0, py = 0;

    function box(w, h, d, x, y, z, color, opacity = 1, opts = {}) {
      const THREE = renderer.__THREE__;
      const m = new THREE.Mesh(
        new THREE.BoxGeometry(w, h, d),
        new THREE.MeshStandardMaterial({
          color,
          roughness: opts.rough ?? 0.85,
          metalness: opts.metal ?? 0,
          emissive: opts.e ?? 0x000000,
          emissiveIntensity: opts.ei ?? 1,
          transparent: opacity < 1,
          opacity,
        })
      );
      m.position.set(x, y, z); rig.add(m);
      m.castShadow = true; m.receiveShadow = true;
      return m;
    }
    function cyl(rt, rb, h, x, y, z, color, opts = {}) {
      const THREE = renderer.__THREE__;
      const m = new THREE.Mesh(
        new THREE.CylinderGeometry(rt, rb, h, 20),
        new THREE.MeshStandardMaterial({ color, roughness: opts.rough ?? 0.75, metalness: opts.metal ?? 0, emissive: opts.e ?? 0x000000, emissiveIntensity: opts.ei ?? 1 })
      );
      m.position.set(x, y, z);
      if (opts.rx) m.rotation.x = opts.rx;
      if (opts.rz) m.rotation.z = opts.rz;
      m.castShadow = true; m.receiveShadow = true;
      rig.add(m);
      return m;
    }
    function blob(x, y, z, color, r) {
      const THREE = renderer.__THREE__;
      const m = new THREE.Mesh(new THREE.IcosahedronGeometry(r, 1), new THREE.MeshStandardMaterial({ color, roughness: 0.9, flatShading: true }));
      m.position.set(x, y, z);
      m.castShadow = true; m.receiveShadow = true;
      rig.add(m);
      return m;
    }
    function pillow(x, y, z, color, s = 1) {
      const THREE = renderer.__THREE__;
      const m = new THREE.Mesh(new THREE.SphereGeometry(0.24, 20, 14), new THREE.MeshStandardMaterial({ color, roughness: 0.95 }));
      m.scale.set(0.95 * s, 0.5 * s, 1.05 * s);
      m.position.set(x, y, z);
      m.castShadow = true; m.receiveShadow = true;
      rig.add(m);
      return m;
    }
    function capsule(r, len, x, y, z, color, axis = "z") {
      const THREE = renderer.__THREE__;
      const m = new THREE.Mesh(new THREE.CapsuleGeometry(r, len, 6, 12), new THREE.MeshStandardMaterial({ color, roughness: 0.85 }));
      if (axis === "z") m.rotation.x = Math.PI / 2;
      if (axis === "x") m.rotation.z = Math.PI / 2;
      m.position.set(x, y, z);
      m.castShadow = true; m.receiveShadow = true;
      rig.add(m);
      return m;
    }
    function knobM(x, y, z) {
      const THREE = renderer.__THREE__;
      const m = new THREE.Mesh(new THREE.SphereGeometry(0.035, 12, 10), new THREE.MeshStandardMaterial({ color: 0xc9ced4, metalness: 0.85, roughness: 0.3 }));
      m.position.set(x, y, z);
      m.castShadow = true;
      rig.add(m);
      return m;
    }
    function tableLamp(x, y, z) {
      cyl(0.05, 0.07, 0.06, x, y + 0.03, z, 0x2b2b2b, { metal: 0.6, rough: 0.4 });
      cyl(0.03, 0.03, 0.24, x, y + 0.17, z, 0x2b2b2b, { metal: 0.6, rough: 0.4 });
      cyl(0.13, 0.18, 0.2, x, y + 0.36, z, 0xe9dab8, { e: 0x6b4d26, ei: 0.4 });
      const THREE = renderer.__THREE__;
      const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.05, 12, 10), new THREE.MeshStandardMaterial({ color: 0xfff3d6, emissive: 0xffc978, emissiveIntensity: 2.2 }));
      bulb.position.set(x, y + 0.24, z);
      rig.add(bulb);
      return bulb;
    }
    // Walls with EXACT gaps: gaps = [{c, w}] in wall-axis coords. Segments auto-fill between gaps.
    function wallXGaps(z, gaps, color) {
      const list = [...gaps].sort((a, b) => a.c - b.c);
      let cur = -RX;
      for (const g of list) {
        const s = g.c - g.w / 2, e = g.c + g.w / 2;
        if (s > cur + 0.01) box(s - cur, WALL_H, WALL_T, (cur + s) / 2, WALL_H / 2, z, color);
        cur = Math.max(cur, e);
      }
      if (RX > cur + 0.01) box(RX - cur, WALL_H, WALL_T, (cur + RX) / 2, WALL_H / 2, z, color);
    }
    function wallZGaps(x, gaps, color) {
      const list = [...gaps].sort((a, b) => a.c - b.c);
      let cur = -RZ;
      for (const g of list) {
        const s = g.c - g.w / 2, e = g.c + g.w / 2;
        if (s > cur + 0.01) box(WALL_T, WALL_H, s - cur, x, WALL_H / 2, (cur + s) / 2, color);
        cur = Math.max(cur, e);
      }
      if (RZ > cur + 0.01) box(WALL_T, WALL_H, RZ - cur, x, WALL_H / 2, (cur + RZ) / 2, color);
    }
    // Window filling its gap: white jambs/head/sill + recessed glass + sill nose + curtain pair INSIDE room
    function windowNS(x, z, w, curtain, inward) {
      const y = 0.85;
      box(w + 0.24, 0.1, WALL_T + 0.12, x, y + 0.55, z, 0xf6f3ea);
      box(w + 0.24, 0.1, WALL_T + 0.12, x, y - 0.55, z, 0xf6f3ea);
      box(0.1, 1.2, WALL_T + 0.12, x - w / 2 - 0.05, y, z, 0xf6f3ea);
      box(0.1, 1.2, WALL_T + 0.12, x + w / 2 + 0.05, y, z, 0xf6f3ea);
      box(w, 0.95, 0.05, x, y, z, 0xbcd6ea, 0.7); // glass in middle of opening
      box(w + 0.3, 0.07, 0.3, x, 0.32, z + inward * 0.2, 0xf6f3ea); // sill nose inside
      box(0.18, 1.15, 0.16, x - w / 2 - 0.24, y, z + inward * 0.22, curtain);
      box(0.18, 1.15, 0.16, x + w / 2 + 0.24, y, z + inward * 0.22, curtain);
    }
    function windowEW(x, z, w, curtain, inward, blinds = false, nocurtains = false) {
      const y = 0.85;
      box(WALL_T + 0.12, 0.1, w + 0.24, x, y + 0.55, z, 0xf6f3ea);
      box(WALL_T + 0.12, 0.1, w + 0.24, x, y - 0.55, z, 0xf6f3ea);
      box(WALL_T + 0.12, 1.2, 0.1, x, y, z - w / 2 - 0.05, 0xf6f3ea);
      box(WALL_T + 0.12, 1.2, 0.1, x, y, z + w / 2 + 0.05, 0xf6f3ea);
      box(0.05, 0.95, w, x, y, z, 0xbcd6ea, 0.7);
      if (blinds) box(0.03, 0.88, w - 0.06, x + inward * 0.03, y, z, 0xf2f2f2);
      if (nocurtains) return;
      box(0.16, 1.15, 0.18, x + inward * 0.22, y, z - w / 2 - 0.24, curtain);
      box(0.16, 1.15, 0.18, x + inward * 0.22, y, z + w / 2 + 0.24, curtain);
    }
    // Door filling its gap: jambs + lintel + threshold + slab hinged at jamb, ajar 40°
    function doorEW(x, z0, dir, color, glass = false) {
      const THREE = renderer.__THREE__;
      box(0.24, 1.2, 0.12, x, 0.6, z0 - 0.53, 0xf6f3ea);
      box(0.24, 1.2, 0.12, x, 0.6, z0 + 0.53, 0xf6f3ea);
      box(0.24, 0.12, 1.18, x, 1.2, z0, 0xf6f3ea);
      box(0.3, 0.05, 1.0, x, 0.03, z0, 0x8a7a5a); // threshold
      const g = new THREE.Group(); g.position.set(x, 0, z0 - 0.46); rig.add(g); // hinge at jamb
      const slab = new THREE.Mesh(new THREE.BoxGeometry(0.07, 1.06, 0.9), new THREE.MeshStandardMaterial({ color, roughness: 0.85 }));
      slab.position.set(dir * 0.3, 0.56, 0.45); slab.rotation.y = dir * -0.75; slab.castShadow = true; g.add(slab);
      const knob = new THREE.Mesh(new THREE.SphereGeometry(0.045, 10, 10), new THREE.MeshStandardMaterial({ color: 0xc9ced4, metalness: 0.85, roughness: 0.3 }));
      knob.position.set(dir * 0.3, 0.55, 0.78); knob.rotation.y = dir * -0.75; g.add(knob);
      if (glass) {
        const gl = new THREE.Mesh(new THREE.BoxGeometry(0.09, 0.58, 0.58), new THREE.MeshStandardMaterial({ color: 0xd8ecf5, transparent: true, opacity: 0.65 }));
        gl.position.set(dir * 0.3, 0.82, 0.45); gl.rotation.y = dir * -0.75; g.add(gl);
      }
      void THREE;
    }
    function update() {
      const sp = Math.sin(phi), cp = Math.cos(phi);
      camera.position.set(radius * sp * Math.cos(theta), radius * cp, radius * sp * Math.sin(theta));
      camera.lookAt(0, 0.3, 0);
    }

    function buildRoom() {
      const floorColor = roomId === "bedroom-1" ? 0xc9bda6 : roomId === "bedroom-2" ? 0xb98145 : 0xc7cdd0;
      const wallColor = roomId === "bedroom-1" ? 0x456f93 : roomId === "bedroom-2" ? 0x74897f : 0xa63d22;
      const THREE = renderer.__THREE__;
      const floor = new THREE.Mesh(new THREE.PlaneGeometry(RX * 2, RZ * 2), new THREE.MeshStandardMaterial({ color: floorColor, roughness: 1 }));
      floor.rotation.x = -Math.PI / 2; rig.add(floor);
      floor.receiveShadow = true;

      if (roomId === "bedroom-1") {
        // AI-concept match: beige carpet, dusty-blue walls, bed W-center, long dresser + TV E,
        // twin louver closets N flanking center window, blue chair center-N, nightstand W-south.
        // N: center window only (closets are furniture boxes, not wall gaps)
        wallXGaps(-RZ, [{ c: 0, w: 1.1 }], wallColor);
        // S: 2 real windows (red curtains) + entry door opening east
        wallXGaps(RZ, [{ c: -1.4, w: 1.0 }, { c: 0.5, w: 1.0 }, { c: 1.85, w: 1.0 }], wallColor);
        // W: far + near windows flanking bed
        wallZGaps(-RX, [{ c: -1.8, w: 1.0 }, { c: 1.9, w: 0.9 }], wallColor);
        // E: narrow far window behind TV zone
        wallZGaps(RX, [{ c: -2.0, w: 0.7 }], wallColor);
        windowNS(0, -RZ, 1.0, 0x3a3f48, 1);
        windowNS(-1.4, RZ, 1.0, 0x8e1f2f, -1); windowNS(0.5, RZ, 1.0, 0x8e1f2f, -1);
        windowEW(-RX, -1.8, 1.0, 0x3a3f48, 1);
        windowEW(-RX, 1.9, 0.9, 0x3a3f48, 1);
        windowEW(RX, -2.0, 0.7, 0x3a3f48, -1);
        // White baseboards like concept
        box(3.85, 0.12, 0.03, 0.575, 0.06, -RZ + 0.085, 0xf6f3ea);
        box(0.1, 0.12, 0.03, -2.45, 0.06, RZ - 0.085, 0xf6f3ea); box(3.9, 0.12, 0.03, 0.55, 0.06, RZ - 0.085, 0xf6f3ea);
        box(0.03, 0.12, 1.3, -RX + 0.085, 0.06, -0.65, 0xf6f3ea); box(0.03, 0.12, 1.35, -RX + 0.085, 0.06, 1.125, 0xf6f3ea);
        box(0.03, 0.12, 1.3, RX - 0.085, 0.06, -0.65, 0xf6f3ea); box(0.03, 0.12, 2.5, RX - 0.085, 0.06, 1.55, 0xf6f3ea);
        // Entry door S wall east, white, ajar into room
        box(0.12, 1.2, 0.24, 1.85 - 0.53, 0.6, RZ, 0xf6f3ea);
        box(0.12, 1.2, 0.24, 1.85 + 0.53, 0.6, RZ, 0xf6f3ea);
