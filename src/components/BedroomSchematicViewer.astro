---
interface Props {
  roomId: string;
  roomLabel: string;
  bedLabel: string;
  features: string[];
  bedSize: "king" | "double" | "queen";
}

const { roomId, roomLabel, bedLabel, features, bedSize } = Astro.props;
const bedFootprint =
  bedSize === "king" ? { w: 2.0, d: 2.2 } : bedSize === "queen" ? { w: 1.8, d: 2.0 } : { w: 1.6, d: 1.9 };
---

<div class="schematic" data-room-viewer={roomId} data-bed-w={bedFootprint.w} data-bed-d={bedFootprint.d}>
  <div class="schematic-controls">
    <button type="button" class="button" data-load-plan aria-expanded="false">Open floor plan</button>
  </div>
  <div class="plan-stage" data-plan-stage hidden>
  <figure class="plan">
    {roomId === "bedroom-1" && (
      <svg viewBox="0 0 360 272" role="img" aria-label="Floor plan of blue king bedroom, 265 square feet">
