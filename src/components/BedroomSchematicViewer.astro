    async function init() {
      try {
        const THREE = await loadThree();
        if (!window.WebGLRenderingContext) throw new Error("WebGL unavailable");
        renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.__THREE__ = THREE;
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.12;
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        const size = () => { const w = Math.min(root.clientWidth || 640, 720); renderer.setSize(w, Math.round(w * 0.62), false); };
        size(); window.addEventListener("resize", size);
        scene = new THREE.Scene(); camera = new THREE.PerspectiveCamera(42, 1.6, 0.1, 100);
        rig = new THREE.Group(); scene.add(rig);
        scene.add(new THREE.HemisphereLight(0xffffff, 0x9a938a, 0.85));
        const key = new THREE.DirectionalLight(0xfff2e0, 2.4);
        key.position.set(5, 8, 4);
        key.castShadow = true;
        key.shadow.mapSize.set(2048, 2048);
        key.shadow.camera.left = -7; key.shadow.camera.right = 7;
        key.shadow.camera.top = 7; key.shadow.camera.bottom = -7;
        key.shadow.camera.near = 1; key.shadow.camera.far = 25;
        key.shadow.bias = -0.0004; key.shadow.normalBias = 0.02;
        scene.add(key);
        const fill = new THREE.DirectionalLight(0xdfe8ff, 0.55);
        fill.position.set(-6, 4, -3); scene.add(fill);
        const glow = new THREE.PointLight(0xffd9a0, 8, 7, 2);
        glow.position.set(-1.6, 2.0, 1.6); scene.add(glow);
        buildRoom();
        const render = () => renderer.render(scene, camera);
        update(); render();
        canvas.addEventListener("pointerdown", (e) => { dragging = true; px = e.clientX; py = e.clientY; canvas.setPointerCapture(e.pointerId); });
        canvas.addEventListener("pointermove", (e) => { if (!dragging) return; theta -= (e.clientX - px) * 0.008; phi = Math.min(1.3, Math.max(0.3, phi - (e.clientY - py) * 0.005)); px = e.clientX; py = e.clientY; update(); render(); });
        canvas.addEventListener("pointerup", () => (dragging = false));
        canvas.addEventListener("wheel", (e) => { e.preventDefault(); radius = Math.min(17, Math.max(5, radius + e.deltaY * 0.01)); update(); render(); }, { passive: false });
        canvas.addEventListener("keydown", (e) => {
          const s = 0.12;
          if (e.key === "ArrowLeft") theta += s; else if (e.key === "ArrowRight") theta -= s;
          else if (e.key === "ArrowUp") phi = Math.max(0.3, phi - s); else if (e.key === "ArrowDown") phi = Math.min(1.3, phi + s);
          else if (e.key === "+" || e.key === "=") radius = Math.max(5, radius - 0.6);
          else if (e.key === "-" || e.key === "_") radius = Math.min(17, radius + 0.6);
           else if (e.key.toLowerCase() === "r") { theta = roomId === "bedroom-2" ? (3 * Math.PI) / 4 : Math.PI / 4; phi = 0.7; radius = 10.5; }
          else return; e.preventDefault(); update(); render();
        });
        function update() {
          const sp = Math.sin(phi), cp = Math.cos(phi);
          camera.position.set(radius * sp * Math.cos(theta), radius * cp, radius * sp * Math.sin(theta));
          camera.lookAt(0, 0.3, 0);
        }
        if (status) status.textContent = "Clean 3D loaded. Drag / arrows to spin, scroll / +/− to zoom, R to reset.";
      } catch (err) {
        if (status) status.textContent = "3D unavailable — plan above is the fallback.";
        console.warn("3D fallback:", err);
      }
    }
    const planBtn = root.querySelector("[data-load-plan]");
    const planStage = root.querySelector("[data-plan-stage]");
    planBtn?.addEventListener("click", () => {
      const open = planStage.hidden;
      planStage.hidden = !open;
      planBtn.setAttribute("aria-expanded", String(open));
      planBtn.textContent = open ? "Close floor plan" : "Open floor plan";
      if (open) planStage.scrollIntoView({ behavior: "smooth", block: "center" });
    });
    btn?.addEventListener("click", async () => {
      const open = stage.hidden; stage.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      btn.textContent = open ? "Close clean 3D" : "Open clean 3D — spin + zoom";
      if (open && !renderer) await init();
    });
  });
