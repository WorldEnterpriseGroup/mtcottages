---
const { currentPath } = Astro.props as { currentPath: string };
const links = [
  ["Cottages", "/cottages.html"],
  ["Locations", "/locations.html"],
  ["How it works", "/room-to-settle.html"],
  ["About", "/about.html"],
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="M&T Cottages home">
      <span class="brand-mark">M<span>&</span>T</span>
      <span class="brand-name">Cottages</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {links.map(([label, href]) => (
          <li>
            <a class:list={{ active: currentPath === href || currentPath.startsWith(href.replace(".html", "")) }} href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="button button-small header-cta" href="/apply.html">Find your cottage <span aria-hidden="true">↗</span></a>
  </div>
</header>
