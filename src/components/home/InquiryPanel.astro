---
import type { HomeShell } from "./shell";

interface Props {
  shell: HomeShell;
  extra?: { label: string; href: string };
}
const { shell, extra } = Astro.props as Props;
---
<section class="section section--dark hm-inquiry" aria-labelledby="hm-inquiry-title">
  <div class="site-width split">
    <div>
      <p class="eyebrow" style="color:#e4b482">{shell.name}</p>
      <h2 id="hm-inquiry-title">Ask about {shell.name}.</h2>
    </div>
    <div>
      <p class="lede lede--light">Share timing, household, and what you need from a place. We confirm availability, pricing, and the right next step.</p>
      <div class="cluster mt-3">
        <a class="button button--light" href={shell.inquiryUrl}>Start a stay inquiry <span aria-hidden="true">↗</span></a>
        {extra && <a class="text-link" style="color:#fff" href={extra.href}>{extra.label}</a>}
      </div>
    </div>
  </div>
</section>
