---
import type { HomeShell } from "./shell";

interface Props {
  shell: HomeShell;
  current: string;
}

const { shell, current } = Astro.props as Props;
// Compare normalised paths so "/x/y/", "/x/y/index.html" and "/x/y" all match the index entry.
const norm = (path: string) => path.replace(/index\.html$/, "").replace(/\/+$/, "");
const isCurrent = (href: string) => norm(current) === norm(href);
const primary = shell.nav.slice(0, 6);
const more = shell.nav.slice(6);
const moreActive = more.some((item) => isCurrent(item.href));
---

<nav class="residence-nav" aria-label={`${shell.name} sections`}>
  <div class="site-width residence-nav-inner">
    <a class="residence-brand" href={shell.baseHref}>
      <span class="residence-brand-mark" aria-hidden="true">{shell.name.charAt(0)}</span>
      <span><strong>{shell.name}</strong><small>{shell.brandSub}</small></span>
    </a>
    <details class="residence-menu">
      <summary>Explore this home</summary>
      <div class="residence-menu-panel">
        <ul>
          {shell.nav.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}><strong>{item.label}</strong><span>{item.description}</span></a></li>
          ))}
        </ul>
      </div>
    </details>
    <ul class="residence-links">
      {primary.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
      ))}
      {more.length > 0 && (
        <li>
          <details class="residence-more">
            <summary aria-current={moreActive ? "page" : undefined}>More</summary>
            <div class="residence-more-panel">
              {more.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}><strong>{item.label}</strong><span>{item.description}</span></a>
              ))}
            </div>
          </details>
        </li>
      )}
    </ul>
    <a class="button residence-cta" href={shell.inquiryUrl}>Ask about this home</a>
  </div>
</nav>
