---
import type { HomeMicrosite } from "../../data/homes/types";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { fullAddress, osmEmbedUrl, osmLargeUrl } from "../../data/homes/links";

// Static street maps built once by scripts/build-home-maps.py (OpenStreetMap tiles).
const maps = import.meta.glob<{ default: ImageMetadata }>("../../../assets/images/maps/*.png", { eager: true });

interface Props { home: HomeMicrosite }
const { home } = Astro.props as Props;
const { lat, lng } = home.address;
const address = fullAddress(home);
const mapImage = maps[`../../../assets/images/maps/${home.id}.png`]?.default;
---
<div class="hm-map" data-map-root data-embed={osmEmbedUrl(lat, lng)} data-title={`Map of ${address}`}>
  <div class="hm-map-poster" data-map-poster>
    {mapImage ? (
      <figure class="hm-map-static">
        <Image src={mapImage} alt={`Street map centred on ${address}, with a pin on the home.`} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 1200px" format="avif" loading="lazy" decoding="async" />
        <span class="hm-map-pin" aria-hidden="true"></span>
        <figcaption class="hm-map-credit">Map data © <a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap contributors<span class="sr-only"> (new tab)</span></a></figcaption>
      </figure>
    ) : (
      <p class="hm-map-fallback">{address} · {lat.toFixed(5)}, {lng.toFixed(5)}</p>
    )}
  </div>
  <div class="cluster mt-2">
    <button type="button" class="button button--ghost" data-map-load>Load interactive map</button>
    <a class="text-link" href={osmLargeUrl(lat, lng)} rel="noopener" target="_blank">Open in OpenStreetMap<span class="sr-only"> (new tab)</span> ↗</a>
  </div>
  <p class="text-muted hm-map-note">The interactive map loads from OpenStreetMap only when you press the button, so nothing is sent to a map service until then.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-map-root]").forEach((root) => {
    if (root.dataset.bound) return;
    root.dataset.bound = "true";
    const button = root.querySelector<HTMLButtonElement>("[data-map-load]")!;
    const poster = root.querySelector<HTMLElement>("[data-map-poster]")!;
    button.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = root.dataset.embed || "";
      frame.title = root.dataset.title || "Map";
      frame.loading = "lazy";
      frame.referrerPolicy = "no-referrer";
      frame.className = "hm-map-frame";
      poster.replaceWith(frame);
      button.hidden = true;
    });
  });
</script>
