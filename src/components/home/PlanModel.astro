---
import type { HomeMicrosite } from "../../data/homes/types";
import { planKindColor } from "../../data/homes/links";
import FloorPlanSvg from "./FloorPlanSvg.astro";

interface Props { home: HomeMicrosite }
const { home } = Astro.props as Props;
const floors = home.plan.floors;
const extent = {
  w: Math.max(0, ...floors.flatMap((f) => f.rooms.map((r) => r.x + r.w))),
  h: Math.max(0, ...floors.flatMap((f) => f.rooms.map((r) => r.y + r.h))),
};
const data = JSON.stringify({ floors, colors: planKindColor });
const id = `model-${home.id}`;
---
<div class="hm-model" data-model-root data-plan={data} data-home={home.name}>
  <div class="hm-model-poster" data-model-poster>
    <div class="hm-plan-set">
      {floors.map((floor) => (
        <figure class="hm-plan">
          <figcaption><strong>{floor.name}</strong></figcaption>
          <FloorPlanSvg floor={floor} homeName={home.name} extent={extent} />
        </figure>
      ))}
    </div>
  </div>
  <div class="hm-model-stage" data-model-stage hidden>
    <canvas id={id} tabindex="0" role="img" aria-label={`Interactive concept 3D model of ${home.name}. Use the buttons below, or the arrow keys to rotate, plus and minus to zoom, R to reset.`}></canvas>
  </div>
  <div class="hm-model-tools cluster mt-2">
    <button type="button" class="button" data-model-open aria-controls={id} aria-expanded="false">Open 3D model</button>
    <div class="hm-model-buttons" role="group" aria-label="3D model controls" hidden data-model-controls>
      <button type="button" class="button button--ghost" data-model-act="left" aria-label="Rotate left">⟲ Rotate left</button>
      <button type="button" class="button button--ghost" data-model-act="right" aria-label="Rotate right">Rotate right ⟳</button>
      <button type="button" class="button button--ghost" data-model-act="in" aria-label="Zoom in">＋ Zoom in</button>
      <button type="button" class="button button--ghost" data-model-act="out" aria-label="Zoom out">－ Zoom out</button>
      <button type="button" class="button button--ghost" data-model-act="reset" aria-label="Reset view">Reset</button>
    </div>
    <p class="text-muted hm-model-status" role="status" data-model-status>The 3D model loads when you press the button.</p>
  </div>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-model-root]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  type Room = { id: string; label: string; kind: string; x: number; y: number; w: number; h: number };
  type Plan = { floors: { name: string; rooms: Room[] }[]; colors: Record<string, string> };

  roots.forEach((root) => {
    if (root.dataset.bound) return;
    root.dataset.bound = "true";
    const openBtn = root.querySelector<HTMLButtonElement>("[data-model-open]")!;
    const stage = root.querySelector<HTMLElement>("[data-model-stage]")!;
    const poster = root.querySelector<HTMLElement>("[data-model-poster]")!;
    const controlsEl = root.querySelector<HTMLElement>("[data-model-controls]")!;
    const status = root.querySelector<HTMLElement>("[data-model-status]")!;
    const canvas = root.querySelector<HTMLCanvasElement>("canvas")!;
    const plan: Plan = JSON.parse(root.dataset.plan || "{}");
    let api: { act: (name: string) => void } | null = null;
    let loading: Promise<void> | null = null;

    const start = async () => {
      status.textContent = "Loading the 3D model…";
      const [THREE, { OrbitControls }] = await Promise.all([
        import("three"),
        import("three/addons/controls/OrbitControls.js"),
      ]);
      const probe = document.createElement("canvas");
      if (!(probe.getContext("webgl2") || probe.getContext("webgl"))) throw new Error("WebGL unavailable");

      const WALL = 3; // low walls: a cutaway so the inside stays visible
      const GAP = 10; // vertical distance between floors
      const T = 0.4; // wall thickness
      const maxX = Math.max(...plan.floors.flatMap((f) => f.rooms.map((r) => r.x + r.w)));
      const maxY = Math.max(...plan.floors.flatMap((f) => f.rooms.map((r) => r.y + r.h)));
      const cx = maxX / 2;
      const cz = maxY / 2;
      const span = Math.max(maxX, maxY);
      const totalH = (plan.floors.length - 1) * GAP + WALL;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0xf3f4ee);
      scene.add(new THREE.HemisphereLight(0xffffff, 0x9a958a, 1.6));
      const sun = new THREE.DirectionalLight(0xffffff, 1.5);
      sun.position.set(-span, span * 1.6, span);
      scene.add(sun);

      const wallMat = new THREE.MeshLambertMaterial({ color: 0x3f4d3c });
      const disposables: { dispose: () => void }[] = [wallMat];
      const addBox = (x: number, y: number, z: number, w: number, h: number, d: number, mat: InstanceType<typeof THREE.Material>) => {
        const geo = new THREE.BoxGeometry(w, h, d);
        disposables.push(geo);
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(x - cx, y, z - cz);
        scene.add(mesh);
      };

      const label = (text: string, x: number, y: number, z: number) => {
        const c = document.createElement("canvas");
        const ctx = c.getContext("2d")!;
        const font = "600 44px system-ui, sans-serif";
        ctx.font = font;
        const w = Math.ceil(ctx.measureText(text).width) + 36;
        c.width = w;
        c.height = 72;
        ctx.font = font;
        ctx.fillStyle = "rgba(255,254,250,.92)";
        ctx.beginPath();
        ctx.roundRect(0, 0, w, 72, 16);
        ctx.fill();
        ctx.fillStyle = "#252525";
        ctx.textBaseline = "middle";
        ctx.fillText(text, 18, 38);
        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        const mat = new THREE.SpriteMaterial({ map: tex, depthTest: false, transparent: true });
        disposables.push(tex, mat);
        const sprite = new THREE.Sprite(mat);
        const h = span * 0.07;
        sprite.scale.set((h * w) / 72, h, 1);
        sprite.position.set(x - cx, y, z - cz);
        sprite.renderOrder = 10;
        scene.add(sprite);
      };

      plan.floors.forEach((floor, level) => {
        const y0 = level * GAP;
        floor.rooms.forEach((r) => {
          const color = new THREE.Color(plan.colors[r.kind] || "#ebe9e1");
          const slab = new THREE.MeshLambertMaterial({ color });
          disposables.push(slab);
          addBox(r.x + r.w / 2, y0 - 0.2, r.y + r.h / 2, r.w, 0.4, r.h, slab);
          const my = y0 + WALL / 2;
          addBox(r.x + r.w / 2, my, r.y, r.w, WALL, T, wallMat);
          addBox(r.x + r.w / 2, my, r.y + r.h, r.w, WALL, T, wallMat);
          addBox(r.x, my, r.y + r.h / 2, T, WALL, r.h, wallMat);
          addBox(r.x + r.w, my, r.y + r.h / 2, T, WALL, r.h, wallMat);
          label(r.label, r.x + r.w / 2, y0 + WALL + 0.8, r.y + r.h / 2);
        });
        if (plan.floors.length > 1) label(floor.name, -2, y0 + WALL + 0.8, -2);
      });

      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, span * 12);
      const target = new THREE.Vector3(0, totalH / 2 - 1, 0);
      const home = new THREE.Vector3(span * 0.55, span * 0.95 + totalH * 0.4, span * 1.05);
      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = false;
      controls.minDistance = span * 0.6;
      controls.maxDistance = span * 4;
      controls.maxPolarAngle = Math.PI * 0.49;
      controls.target.copy(target);

      const render = () => renderer.render(scene, camera);
      const resize = () => {
        const w = Math.max(280, Math.round(stage.clientWidth));
        const h = Math.round(Math.min(w * 0.72, 640));
        renderer.setSize(w, h, false);
        canvas.style.height = `${h}px`;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        render();
      };
      const reset = () => {
        camera.position.copy(home);
        controls.target.copy(target);
        controls.update();
        render();
      };
      const orbit = (dTheta: number) => {
        const off = camera.position.clone().sub(controls.target);
        const s = new THREE.Spherical().setFromVector3(off);
        s.theta += dTheta;
        camera.position.copy(controls.target).add(new THREE.Vector3().setFromSpherical(s));
        controls.update();
        render();
      };
      const dolly = (factor: number) => {
        const off = camera.position.clone().sub(controls.target);
        const len = Math.min(controls.maxDistance, Math.max(controls.minDistance, off.length() * factor));
        camera.position.copy(controls.target).add(off.setLength(len));
        controls.update();
        render();
      };
      const act = (name: string) => {
        if (name === "left") orbit(-Math.PI / 8);
        else if (name === "right") orbit(Math.PI / 8);
        else if (name === "in") dolly(0.8);
        else if (name === "out") dolly(1.25);
        else if (name === "reset") reset();
      };
      controls.addEventListener("change", render);
      canvas.addEventListener("keydown", (e) => {
        const map: Record<string, string> = { ArrowLeft: "left", ArrowRight: "right", "+": "in", "=": "in", "-": "out", _: "out", r: "reset", R: "reset" };
        if (map[e.key]) {
          e.preventDefault();
          act(map[e.key]);
        }
      });
      new ResizeObserver(resize).observe(stage);

      stage.hidden = false;
      poster.hidden = true;
      controlsEl.hidden = false;
      resize();
      reset();
      api = { act };
      root.dataset.modelReady = "true";
      status.textContent = reduceMotion
        ? "3D model ready. Use the buttons or arrow keys; the model does not animate."
        : "3D model ready. Drag to rotate, scroll to zoom, or use the buttons.";
      openBtn.hidden = true;
      canvas.focus({ preventScroll: true });
    };

    openBtn.addEventListener("click", () => {
      openBtn.setAttribute("aria-expanded", "true");
      openBtn.disabled = true;
      loading ??= start().catch(() => {
        status.textContent = "The 3D model could not start in this browser. The floor plan above shows the same layout.";
        openBtn.disabled = false;
        openBtn.setAttribute("aria-expanded", "false");
        loading = null;
      });
    });
    root.querySelectorAll<HTMLButtonElement>("[data-model-act]").forEach((button) => {
      button.addEventListener("click", () => api?.act(button.dataset.modelAct || ""));
    });
  });
</script>
