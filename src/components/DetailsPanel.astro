---
import type { Cottage } from "../data/site";
const { cottage } = Astro.props as { cottage: Cottage };
---
<aside class="details-panel" aria-labelledby="quick-details-title">
  <div class="cluster" style="justify-content:space-between">
    <h2 id="quick-details-title">Quick details</h2>
    <span class="eyebrow">At a glance</span>
  </div>
  <div class="details-grid">
    <div class="detail"><span class="detail-icon" aria-hidden="true">⌂</span><span class="detail-label">Location</span><span class="detail-value">{cottage.town}</span></div>
    <div class="detail"><span class="detail-icon" aria-hidden="true">▦</span><span class="detail-label">Space</span><span class="detail-value">{cottage.bedrooms}</span></div>
    <div class="detail"><span class="detail-icon" aria-hidden="true">◌</span><span class="detail-label">Home type</span><span class="detail-value">{cottage.signals.homeType}</span></div>
    <div class="detail"><span class="detail-icon" aria-hidden="true">↗</span><span class="detail-label">Connectivity</span><span class="detail-value">{cottage.signals.connectivity}</span></div>
    <div class="detail"><span class="detail-icon" aria-hidden="true">⌁</span><span class="detail-label">Setting</span><span class="detail-value">{cottage.signals.setting}</span></div>
  </div>
  <div class="price-block">
    <span class="detail-label">Published monthly guide</span>
    <strong>{cottage.price}</strong>
    <span class="text-muted">{cottage.pricingNote} {cottage.shortTerm}</span>
  </div>
  <a class="button" href={`/apply.html?property=${encodeURIComponent(cottage.id)}`}>Ask about this home <span aria-hidden="true">↗</span></a>
  <p class="details-note">An inquiry starts a conversation. It is not a lease, approval, or guarantee of availability.</p>
</aside>
