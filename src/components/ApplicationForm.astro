<form action="https://stay.mtcottages.com/api/apply" method="post" class="application-form" data-application-form novalidate>
  <div class="form-grid">
    <label>First name<input type="text" name="firstName" autocomplete="given-name" required /></label>
    <label>Last name<input type="text" name="lastName" autocomplete="family-name" required /></label>
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
    <label>Phone<input type="tel" name="phone" autocomplete="tel" required /></label>
    <label>Preferred move-in date<input type="date" name="moveInDate" required /></label>
    <label>How long might you stay?
      <select name="duration" required><option value="">Choose one</option><option>30–90 days</option><option>3–12 months</option><option>1 year or longer</option><option>Flexible / not sure</option></select>
    </label>
    <label>Number of occupants<input type="number" name="occupants" min="1" max="20" required /></label>
    <label>Preferred community
      <select name="preferredLocation" required><option value="">Choose one</option><option>Marietta, OH</option><option>Parkersburg, WV</option><option>Ravenswood, WV</option><option>Grantsville, WV</option><option>Racine, OH</option><option>Athens, OH</option><option>Open to options</option></select>
    </label>
    <label>What kind of place feels right?
      <select name="homeSize"><option value="">Choose one</option><option>Studio or one-bedroom</option><option>Two-bedroom</option><option>Three-bedroom</option><option>Four-bedroom</option><option>Open to options</option></select>
    </label>
    <label>What brings you here?
      <select name="stayType" required><option value="">Choose one</option><option>Travel or healthcare assignment</option><option>Work or relocation</option><option>Insurance housing</option><option>Family or extended stay</option><option>Research or fellowship</option><option>Personal transition</option><option>Something else</option></select>
    </label>
    <label>Pets
      <select name="pets"><option value="">Choose one</option><option>No pets</option><option>Yes — I’ll share details below</option><option>Prefer to discuss</option></select>
    </label>
    <label>Role, employer, or assignment<input type="text" name="employment" /></label>
    <label>Approximate monthly budget<input type="text" name="monthlyBudget" /></label>
    <label>Furnishing or accessibility needs<input type="text" name="furnishedNeeds" /></label>
    <label class="form-wide">Tell us about your dates, household, work, pets, and what would make a place fit<textarea name="message" required></textarea></label>
    <label class="form-wide checkbox-label"><input type="checkbox" name="screeningConsent" value="yes" /> I understand screening may be part of a later application step.</label>
    <label class="form-wide checkbox-label"><input type="checkbox" name="termsAccepted" value="yes" required /> I confirm this is an inquiry and the information is accurate.</label>
    <div class="honeypot" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
    <input type="hidden" name="sourceUrl" />
  </div>
  <button class="button" type="submit">Send my inquiry <span aria-hidden="true">↗</span></button>
</form>
